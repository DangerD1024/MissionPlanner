<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Mobile"
             xmlns:fd="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:mc="using:MissionPlanner.Mobile.Controls"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.Mobile.Views.MessagesView"
             x:DataType="vm:MobileShellViewModel">
  <Grid RowDefinitions="Auto,*" Margin="12,10,12,0" MaxWidth="900">
    <TextBlock Classes="h2" Text="{l:Tr 'Vehicle messages'}" Margin="4,0,0,8" />
    <ListBox Grid.Row="1" Background="Transparent" ItemsSource="{Binding Fly.Messages}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="fd:MessageLine">
          <Grid ColumnDefinitions="Auto,*" Margin="4,6">
            <TextBlock Text="{Binding TimeText}" Classes="muted" FontSize="12" FontFamily="monospace" Margin="0,2,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                       Foreground="{Binding Level, Converter={x:Static mc:MessageBrush.Instance}}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
