<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:sv="using:MissionPlanner.Mobile.Views.Setup"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.Mobile.Views.Setup.BatteryPage"
             x:DataType="vm:BatteryMonitorViewModel">
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12" MaxWidth="760">
      <!-- what the autopilot reads now -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,*">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'VOLTAGE'}" />
            <TextBlock Text="{Binding VoltageText}" FontSize="26" FontWeight="Bold" />
          </StackPanel>
          <StackPanel Grid.Column="1" IsVisible="{Binding HasCurrent}">
            <TextBlock Classes="label" Text="{l:Tr 'CURRENT'}" />
            <TextBlock Text="{Binding CurrentText}" FontSize="26" FontWeight="Bold" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{l:Tr 'MONITOR'}" />
          <sv:ParamFieldRow DataContext="{Binding Monitor}" />
          <sv:ParamFieldRow DataContext="{Binding Capacity}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsAnalog}" Margin="0,6,0,0">
            <TextBlock Text="{l:Tr 'Sensor'}" FontSize="14" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" HorizontalAlignment="Stretch" MinHeight="48" />
            <TextBlock Text="{l:Tr 'Autopilot board'}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" HorizontalAlignment="Stretch" MinHeight="48" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- calibrate with a voltmeter / clamp meter -->
      <Border Classes="card" IsVisible="{Binding IsAnalog}">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{l:Tr 'CALIBRATE'}" />
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                     Text="{l:Tr 'Measure the battery with a voltmeter (and the current with a clamp meter), enter the readings and press Calibrate.'}" />
          <Grid ColumnDefinitions="*,8,Auto">
            <NumericUpDown Value="{Binding MeasuredVoltage}" Minimum="0" Maximum="1000" Increment="0.01" FormatString="0.00"
                           Watermark="{l:Tr 'Measured volts'}" MinHeight="48" TextInputOptions.ContentType="Number" />
            <Button Grid.Column="2" Classes="primary" Content="{l:Tr 'Calibrate'}" Command="{Binding CalibrateVoltageCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding HasCurrent}">
            <NumericUpDown Value="{Binding MeasuredCurrent}" Minimum="0" Maximum="10000" Increment="0.1" FormatString="0.0"
                           Watermark="{l:Tr 'Measured amps'}" MinHeight="48" TextInputOptions.ContentType="Number" />
            <Button Grid.Column="2" Classes="primary" Content="{l:Tr 'Calibrate'}" Command="{Binding CalibrateCurrentCommand}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CalibrationNote}" />
          <sv:ParamFieldRow DataContext="{Binding VoltMult}" />
          <sv:ParamFieldRow DataContext="{Binding AmpPerVolt}" />
          <sv:ParamFieldRow DataContext="{Binding AmpOffset}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
