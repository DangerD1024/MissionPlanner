<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.Mobile.Views.Setup.SensorsPage"
             x:DataType="vm:RawSensorsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:RawValue">
      <Grid ColumnDefinitions="78,*,64" Margin="0,3">
        <TextBlock Text="{l:TrBind {Binding Label}}" FontSize="13" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" Height="10" MinHeight="10"
                     CornerRadius="5" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" FontFamily="monospace" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">
      <TextBlock Classes="muted" FontSize="12" Text="{l:TrBind {Binding Note}}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Imus}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RawSensorsViewModel+RawGroup">
            <Border Classes="card" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Classes="label" Text="{l:TrBind {Binding Title}}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Values}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="label" Text="{l:Tr 'RC IN'}" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding RcIn}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="label" Text="{l:Tr 'SERVO OUT'}" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding ServoOut}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
