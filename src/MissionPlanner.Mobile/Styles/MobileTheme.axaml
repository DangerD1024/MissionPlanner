<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:MissionPlanner.App.Controls"
        xmlns:mc="using:MissionPlanner.Mobile.Controls">

  <!--
    Phone theme: dark, high contrast for daylight (as DJI Fly / QGroundControl), 48 px touch
    targets, translucent panels over the map. Status colours: green ok, amber warning, red bad.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="MBg">#0B0E13</Color>
      <SolidColorBrush x:Key="Bg" Color="#0B0E13" />
      <SolidColorBrush x:Key="Surface" Color="#151A21" />
      <SolidColorBrush x:Key="Surface2" Color="#1E242D" />
      <SolidColorBrush x:Key="Glass" Color="#D9101419" />
      <SolidColorBrush x:Key="GlassLight" Color="#B31A2029" />
      <SolidColorBrush x:Key="Line" Color="#2A313C" />
      <SolidColorBrush x:Key="Text" Color="#F2F5F8" />
      <SolidColorBrush x:Key="Muted" Color="#8B95A3" />
      <SolidColorBrush x:Key="Accent" Color="#3AA0FF" />
      <SolidColorBrush x:Key="AccentDim" Color="#263AA0FF" />
      <SolidColorBrush x:Key="Ok" Color="#2FD27A" />
      <SolidColorBrush x:Key="Warn" Color="#FFB020" />
      <SolidColorBrush x:Key="Bad" Color="#FF4D4F" />
      <SolidColorBrush x:Key="OkDim" Color="#332FD27A" />
      <SolidColorBrush x:Key="WarnDim" Color="#33FFB020" />
      <SolidColorBrush x:Key="BadDim" Color="#33FF4D4F" />

      <StreamGeometry x:Key="IcFly">M12,3 L12,21 M3,12 L21,12 M12,3 L9,6 M12,3 L15,6 M5.5,9.5 A2.3,2.3 0 1 0 5.51,9.5 M18.5,9.5 A2.3,2.3 0 1 0 18.51,9.5 M5.5,14.5 A2.3,2.3 0 1 0 5.51,14.5 M18.5,14.5 A2.3,2.3 0 1 0 18.51,14.5</StreamGeometry>
      <StreamGeometry x:Key="IcPlan">M3,6 L9,3.5 L15,6 L21,3.5 L21,18 L15,20.5 L9,18 L3,20.5 Z M9,3.5 L9,18 M15,6 L15,20.5</StreamGeometry>
      <StreamGeometry x:Key="IcParams">M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M15,10 L15,14 M7,16 L7,20</StreamGeometry>
      <StreamGeometry x:Key="IcMessages">M4,5 L20,5 L20,16 L10,16 L6,20 L6,16 L4,16 Z M8,9 L16,9 M8,12 L13,12</StreamGeometry>
      <StreamGeometry x:Key="IcLink">M9,3 L9,7 M15,3 L15,7 M7,7 L17,7 L17,11 A5,5 0 0 1 7,11 Z M12,16 L12,21</StreamGeometry>
      <StreamGeometry x:Key="IcGps">M12,21 C12,21 5,13.5 5,9 A7,7 0 0 1 19,9 C19,13.5 12,21 12,21 Z M12,6.5 A2.5,2.5 0 1 0 12.01,6.5</StreamGeometry>
      <StreamGeometry x:Key="IcBattery">M3,8 L18,8 L18,16 L3,16 Z M18,10.5 L20.5,10.5 L20.5,13.5 L18,13.5</StreamGeometry>
      <StreamGeometry x:Key="IcSignal">M4,19 L4,16 M9,19 L9,12 M14,19 L14,8 M19,19 L19,4</StreamGeometry>
      <StreamGeometry x:Key="IcTakeoff">M12,20 L12,6 M6,12 L12,6 L18,12 M5,4 L19,4</StreamGeometry>
      <StreamGeometry x:Key="IcLand">M12,4 L12,18 M6,12 L12,18 L18,12 M5,20 L19,20</StreamGeometry>
      <StreamGeometry x:Key="IcRtl">M4,11 L12,4 L20,11 M6.5,9 L6.5,20 L17.5,20 L17.5,9 M10,20 L10,14 L14,14 L14,20</StreamGeometry>
      <StreamGeometry x:Key="IcPause">M8,5 L8,19 M16,5 L16,19</StreamGeometry>
      <StreamGeometry x:Key="IcPower">M12,3 L12,12 M7,6.5 A7.5,7.5 0 1 0 17,6.5</StreamGeometry>
      <StreamGeometry x:Key="IcCenter">M12,8.5 A3.5,3.5 0 1 0 12.01,8.5 M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12</StreamGeometry>
      <StreamGeometry x:Key="IcSwap">M7,4 L7,18 M3,14 L7,18 L11,14 M17,20 L17,6 M13,10 L17,6 L21,10</StreamGeometry>
      <StreamGeometry x:Key="IcPlus">M12,5 L12,19 M5,12 L19,12</StreamGeometry>
      <StreamGeometry x:Key="IcMinus">M5,12 L19,12</StreamGeometry>
      <StreamGeometry x:Key="IcClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
      <StreamGeometry x:Key="IcSearch">M10.5,4 A6.5,6.5 0 1 0 10.51,4 M15.5,15.5 L20,20</StreamGeometry>
      <StreamGeometry x:Key="IcRefresh">M19,12 A7,7 0 1 1 16.5,6.6 M17,3 L17,7 L13,7</StreamGeometry>
      <StreamGeometry x:Key="IcDownload">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</StreamGeometry>
      <StreamGeometry x:Key="IcUpload">M12,15 L12,4 M7,9 L12,4 L17,9 M5,20 L19,20</StreamGeometry>
      <StreamGeometry x:Key="IcDelete">M5,7 L19,7 M10,7 L10,4.5 L14,4.5 L14,7 M7,7 L8,20 L16,20 L17,7</StreamGeometry>
      <StreamGeometry x:Key="IcAdd">M12,21 C12,21 5,13.5 5,9 A7,7 0 0 1 19,9 C19,13.5 12,21 12,21 Z M12,6 L12,12 M9,9 L15,9</StreamGeometry>
      <StreamGeometry x:Key="IcChevronDown">M6,9 L12,15 L18,9</StreamGeometry>
      <StreamGeometry x:Key="IcChevronUp">M6,15 L12,9 L18,15</StreamGeometry>
      <StreamGeometry x:Key="IcSetup">M14.5,4 A4.5,4.5 0 0 0 10.2,9.8 L3.8,16.2 A1.9,1.9 0 0 0 6.5,18.9 L12.9,12.5 A4.5,4.5 0 0 0 18.7,8.2 L16.1,10.8 L13.6,10.1 L12.9,7.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IcLevel">M3,15 L21,15 M6,15 L6,11 L18,11 L18,15 M12,4 L12,8 M9,6 L12,8 L15,6</StreamGeometry>
      <StreamGeometry x:Key="IcCompass">M12,3 A9,9 0 1 0 12.01,3 M15.5,8.5 L13.4,13.4 L8.5,15.5 L10.6,10.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IcRadio">M5,9 L19,9 L19,21 L5,21 Z M8,13 A1.5,1.5 0 1 0 8.01,13 M16,13 A1.5,1.5 0 1 0 16.01,13 M8,9 L5,3 M16,9 L19,3 M9,18 L15,18</StreamGeometry>
      <StreamGeometry x:Key="IcSensors">M3,12 L7,12 L9,6 L12,18 L15,9 L17,12 L21,12</StreamGeometry>
      <StreamGeometry x:Key="IcShield">M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z M9,12 L11,14 L15,10</StreamGeometry>
      <StreamGeometry x:Key="IcFrame">M6,6 L18,18 M18,6 L6,18 M6,3.5 A2.5,2.5 0 1 0 6.01,3.5 M18,3.5 A2.5,2.5 0 1 0 18.01,3.5 M6,15.5 A2.5,2.5 0 1 0 6.01,15.5 M18,15.5 A2.5,2.5 0 1 0 18.01,15.5</StreamGeometry>
      <StreamGeometry x:Key="IcMotor">M12,9 A3,3 0 1 0 12.01,9 M12,9 C10,5 10,3 12,3 C14,3 14,5 12,9 M15,12 C19,10 21,10 21,12 C21,14 19,14 15,12 M12,15 C14,19 14,21 12,21 C10,21 10,19 12,15 M9,12 C5,14 3,14 3,12 C3,10 5,10 9,12</StreamGeometry>
      <StreamGeometry x:Key="IcBack">M15,5 L8,12 L15,19</StreamGeometry>
      <StreamGeometry x:Key="IcChevronRight">M9,6 L15,12 L9,18</StreamGeometry>
      <StreamGeometry x:Key="IcTarget">M12,4 A8,8 0 1 0 12.01,4 M12,9 A3,3 0 1 0 12.01,9</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- line icons (mc:Icon draws a 24x24 glyph centred) -->
  <Style Selector="mc|Icon">
    <Setter Property="Stroke" Value="{StaticResource Text}" />
  </Style>

  <!-- cards and panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource Glass}" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- buttons: big, rounded -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#06121F" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#06121F" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Bad}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- round floating map buttons -->
  <Style Selector="Button.fab">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="{StaticResource Glass}" />
  </Style>

  <!-- the Fly action bar: icon over a word -->
  <Style Selector="Button.action">
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.action TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action.arm">
    <Setter Property="Background" Value="#1F6B43" />
  </Style>
  <Style Selector="Button.action.disarm">
    <Setter Property="Background" Value="#8E2426" />
  </Style>

  <!-- bottom navigation -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="60" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tab mc|Icon">
    <Setter Property="Stroke" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="Button.tab TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab.on mc|Icon">
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.tab.on TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>

  <!-- status chips in the top bar -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
  </Style>

  <Style Selector="Border.chip.cur">
    <Setter Property="Background" Value="{StaticResource AccentDim}" />
  </Style>
  <Style Selector="Border.chip.done">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <!-- text boxes -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- drawn controls keep their geometry unmirrored in right-to-left languages -->
  <Style Selector="c|MapView, c|Hud, mc|SlideToConfirm, mc|Icon">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>
</Styles>
