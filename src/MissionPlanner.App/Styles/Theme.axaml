<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- palette: Mission Planner's dark look, flattened -->
      <Color x:Key="Bg0Color">#101317</Color>
      <Color x:Key="Bg1Color">#161a1f</Color>
      <Color x:Key="Bg2Color">#1c2127</Color>
      <Color x:Key="Bg3Color">#252b33</Color>
      <Color x:Key="LineColor">#2c333c</Color>
      <Color x:Key="TextColor">#e6e9ed</Color>
      <Color x:Key="MutedColor">#9aa4b0</Color>
      <Color x:Key="AccentColor">#8cc63f</Color>
      <Color x:Key="AccentHoverColor">#a2d65c</Color>
      <Color x:Key="AccentTextColor">#0f1a05</Color>
      <Color x:Key="DangerColor">#e5534b</Color>
      <Color x:Key="WarnColor">#f0b429</Color>
      <Color x:Key="InfoColor">#4fa3e3</Color>

      <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
      <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
      <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
      <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
      <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />

      <!-- Fluent accent follows the palette -->
      <Color x:Key="SystemAccentColor">#8cc63f</Color>
      <Color x:Key="SystemAccentColorDark1">#7ab32f</Color>
      <Color x:Key="SystemAccentColorLight1">#a2d65c</Color>

      <!-- 24x24 outline icons, drawn with a stroke -->
      <StreamGeometry x:Key="IconData">M4,17 A8,8 0 1 1 20,17 M12,17 L16,10.5 M4,17 L20,17 M7.5,11 L8.6,12 M12,7.5 L12,9 M16.5,11 L15.4,12</StreamGeometry>
      <StreamGeometry x:Key="IconPlan">M3,6 L9,3.5 L15,6 L21,3.5 L21,18 L15,20.5 L9,18 L3,20.5 Z M9,3.5 L9,18 M15,6 L15,20.5</StreamGeometry>
      <StreamGeometry x:Key="IconSetup">M7,7 L17,7 L17,17 L7,17 Z M10,7 L10,4 M14,7 L14,4 M10,17 L10,20 M14,17 L14,20 M7,10 L4,10 M7,14 L4,14 M17,10 L20,10 M17,14 L20,14 M10,10 L14,10 L14,14 L10,14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconConfig">M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M15,10 L15,14 M7,16 L7,20</StreamGeometry>
      <StreamGeometry x:Key="IconSim">M3,4.5 L21,4.5 L21,16 L3,16 Z M8,20 L16,20 M12,16 L12,20 M10,7.5 L15,10.2 L10,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconHelp">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M9.5,9.5 A2.6,2.6 0 1 1 13.2,11.9 C12.4,12.3 12,12.8 12,13.8 M12,16.8 L12,17</StreamGeometry>
      <StreamGeometry x:Key="IconConnect">M9,3 L9,7 M15,3 L15,7 M7,7 L17,7 L17,11 A5,5 0 0 1 7,11 Z M12,16 L12,21</StreamGeometry>
      <StreamGeometry x:Key="IconDisconnect">M9,3 L9,7 M15,3 L15,7 M7,7 L17,7 L17,11 A5,5 0 0 1 7,11 Z M12,16 L12,21 M4,4 L20,20</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M19,12 A7,7 0 1 1 16.5,6.6 M17,3 L17,7 L13,7</StreamGeometry>
      <StreamGeometry x:Key="IconChevron">M9,6 L15,12 L9,18</StreamGeometry>
      <StreamGeometry x:Key="IconUp">M6,15 L12,9 L18,15</StreamGeometry>
      <StreamGeometry x:Key="IconDown">M6,9 L12,15 L18,9</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M5,7 L19,7 M10,7 L10,4.5 L14,4.5 L14,7 M7,7 L8,20 L16,20 L17,7 M10.5,11 L10.5,16.5 M13.5,11 L13.5,16.5</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M6,3 L14,3 L19,8 L19,21 L6,21 Z M14,3 L14,8 L19,8</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- an outline icon: <Path Classes="icon" Data="{StaticResource IconPlan}" /> -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- primary action buttons in Mission Planner green -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- top navigation: icon over caption -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <Grid RowDefinitions="Auto,4,Auto">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
            <Border Grid.Row="2" Name="bar" Height="2" CornerRadius="1" Width="22" Background="Transparent" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{StaticResource Bg3}" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bar">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <!-- left sub-menus (Setup / Config) -->
  <Style Selector="ListBox.sidemenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style Selector="ListBox.sidemenu ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.sidemenu ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBox.sidemenu ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
  </Style>

  <!-- panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Bg1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource Bg1}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
  </Style>
</Styles>
