<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MissionPlanner.App"
             x:Class="MissionPlanner.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://MissionPlanner.App/Styles/Theme.axaml" />
  </Application.Styles>

  <!-- pages are found by name: ViewModels.X.FooViewModel shows Views.X.FooView -->
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

</Application>
