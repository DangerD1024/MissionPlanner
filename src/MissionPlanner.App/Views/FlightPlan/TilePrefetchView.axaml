<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightPlan"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightPlan.TilePrefetchView"
             x:DataType="vm:TilePrefetchViewModel">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Classes="h2" Text="{l:Tr 'Prefetch map tiles'}" />
    <TextBlock Classes="muted" FontSize="12">
      <Run Text="{Binding ProviderName}" />
      <Run Text="·" />
      <Run Text="{Binding ZoomText}" />
    </TextBlock>
    <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Completed}" Height="14" />
    <TextBlock Text="{Binding ProgressText}" />
    <Button HorizontalAlignment="Right" MinWidth="90" Content="{l:TrBind {Binding ButtonText}}" Command="{Binding ButtonCommand}" />
  </StackPanel>
</UserControl>
