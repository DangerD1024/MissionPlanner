<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightData.TlogPlayerView"
             x:DataType="vm:TlogPlayerViewModel">

  <UserControl.Resources>
    <StreamGeometry x:Key="GlyphPlay">M7,4.5 L19.5,12 L7,19.5 Z</StreamGeometry>
    <StreamGeometry x:Key="GlyphPause">M6.5,5 L10.5,5 L10.5,19 L6.5,19 Z M13.5,5 L17.5,5 L17.5,19 L13.5,19 Z</StreamGeometry>
    <StreamGeometry x:Key="GlyphStop">M6.5,6.5 L17.5,6.5 L17.5,17.5 L6.5,17.5 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- filled transport glyphs in the button's text colour -->
    <!-- the content presenter's colour, which greys out with a disabled button (the button's own does not) -->
    <Style Selector="Path.glyph">
      <Setter Property="Fill" Value="{Binding $self.(TextElement.Foreground)}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.transport">
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- speed: one segmented row -->
    <Style Selector="ListBox.segments">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ListBox.segments > ListBoxItem">
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.segments > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="ListBox.segments > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="6,8" Spacing="12">

      <!-- the file -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Button Classes="accent" Command="{Binding LoadLogCommand}" Height="32" Padding="12,0"
                VerticalContentAlignment="Center" ToolTip.Tip="{l:Tr 'Open a telemetry log (.tlog) and play it'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Data="{StaticResource IconFolder}" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $self.(TextElement.Foreground)}" />
            <TextBlock Text="{l:Tr 'Load Log'}" VerticalAlignment="Center" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding FileName}" IsVisible="{Binding IsLoaded}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
          <TextBlock Text="{l:Tr 'No log loaded'}" IsVisible="{Binding !IsLoaded}" Classes="muted" />
          <TextBlock Text="{Binding DetailsText}" IsVisible="{Binding IsLoaded}" Classes="muted" FontSize="11.5"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetailsText}" />
        </StackPanel>
      </Grid>

      <!-- where we are in it -->
      <Border Classes="card" Padding="14,10,14,12" Background="{DynamicResource Bg2}" CornerRadius="8"
              BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Bottom">
              <Run Text="{Binding ElapsedText}" FontSize="26" FontWeight="Bold" />
              <Run Text=" / " FontSize="16" Foreground="{DynamicResource Muted}" />
              <Run Text="{Binding DurationText}" FontSize="16" Foreground="{DynamicResource Muted}" />
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="muted" FontSize="13"
                       VerticalAlignment="Bottom" Margin="0,0,0,4" />
          </Grid>
          <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" SmallChange="0.5" LargeChange="5"
                  Value="{Binding PositionPercent}" IsEnabled="{Binding IsLoaded}"
                  ToolTip.Tip="{l:Tr 'Position in the log; drag to jump'}" />
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="{l:Tr 'Log time'}" Classes="muted" FontSize="11.5" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding LogClockText}" FontSize="11.5" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- transport -->
      <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
        <Button Classes="accent transport" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{l:Tr 'Play or pause the log'}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel>
              <Path Classes="glyph" Data="{StaticResource GlyphPlay}" IsVisible="{Binding !IsPlaying}" />
              <Path Classes="glyph" Data="{StaticResource GlyphPause}" IsVisible="{Binding IsPlaying}" />
            </Panel>
            <TextBlock Text="{l:TrBind {Binding PlayPauseText}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="transport" Command="{Binding StopCommand}"
                ToolTip.Tip="{l:Tr 'Stop playback and close the log'}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="glyph" Data="{StaticResource GlyphStop}" />
            <TextBlock Text="{l:Tr 'Stop'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Text="{l:Tr 'Playback speed'}" Classes="muted" FontSize="12" />
        <ListBox Classes="segments" ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TlogSpeedOption">
              <TextBlock Text="{l:TrBind {Binding Label}}" HorizontalAlignment="Center" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <TextBlock Classes="muted status" Classes.error="{Binding StatusIsError}" Text="{l:TrBind {Binding StatusText}}"
                 TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
