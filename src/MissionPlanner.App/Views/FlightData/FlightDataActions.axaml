<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightData.FlightDataActions"
             x:DataType="vm:FlightDataViewModel">

  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ComboBox, NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="2,0,0,4" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel>
      <StackPanel Margin="8" Spacing="8" IsEnabled="{Binding IsConnected}">

        <!-- the big four -->
        <UniformGrid Columns="4" ColumnSpacing="6">
          <Button Content="{l:TrBind {Binding ArmText}}" Classes.danger="{Binding IsArmed}" Classes.accent="{Binding !IsArmed}"
                  Command="{Binding ArmDisarmCommand}" IsEnabled="{Binding CanCommand}" ToolTip.Tip="{l:Tr 'Arm or disarm the motors'}" />
          <Button Content="{l:Tr 'Auto'}" Classes="accent" Command="{Binding AutoCommand}" IsEnabled="{Binding CanCommand}" />
          <Button Content="{l:Tr 'Loiter'}" Classes="accent" Command="{Binding LoiterCommand}" IsEnabled="{Binding CanCommand}" />
          <Button Content="{l:Tr 'RTL'}" Classes="accent" Command="{Binding RtlCommand}" IsEnabled="{Binding CanCommand}" />
        </UniformGrid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{l:Tr 'Flight mode'}" />
          <ComboBox Grid.Row="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                    PlaceholderText="{l:Tr 'No modes for this firmware'}" x:Name="ModeCombo" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Set Mode'}" Classes="accent" Command="{Binding SetModeCommand}"
                  IsEnabled="{Binding CanCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{l:Tr 'Waypoint'}" />
          <ComboBox Grid.Row="1" ItemsSource="{Binding WaypointNumbers}" SelectedIndex="{Binding SelectedWaypoint}" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Set WP'}" Classes="accent" Command="{Binding SetWaypointCommand}"
                  IsEnabled="{Binding CanCommand}" ToolTip.Tip="{l:Tr 'Fly to this mission item next'}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{l:Tr 'Action'}" />
          <ComboBox Grid.Row="1" ItemsSource="{Binding DoActions}" SelectedItem="{Binding SelectedDoAction}" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Do Action'}" Classes="accent" Command="{Binding DoActionCommand}"
                  IsEnabled="{Binding CanCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{Binding AltitudeUnit, StringFormat='Altitude ({0})'}" />
          <NumericUpDown Grid.Row="1" Value="{Binding NewAltitude}" Minimum="-1000" Maximum="100000" Increment="5"
                         FormatString="0.#" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Change Alt'}" Classes="accent" Command="{Binding ChangeAltitudeCommand}"
                  IsEnabled="{Binding CanCommand}" ToolTip.Tip="{l:Tr 'New altitude for the current target'}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{Binding SpeedUnit, StringFormat='Speed ({0})'}" />
          <NumericUpDown Grid.Row="1" Value="{Binding NewSpeed}" Minimum="0" Maximum="1000" Increment="1" FormatString="0.#" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Change Speed'}" Classes="accent" Command="{Binding ChangeSpeedCommand}"
                  IsEnabled="{Binding CanCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto" IsVisible="{Binding HasLoiterRadius}">
          <TextBlock Classes="caption" Text="{Binding DistanceUnit, StringFormat='Loiter radius ({0})'}" />
          <NumericUpDown Grid.Row="1" Value="{Binding NewLoiterRadius}" Minimum="-32767" Maximum="32767" Increment="5" FormatString="0" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Set Radius'}" Classes="accent" Command="{Binding ChangeLoiterRadiusCommand}"
                  IsEnabled="{Binding CanCommand}" ToolTip.Tip="{l:Tr 'Loiter radius (LOITER_RAD or WP_LOITER_RAD); negative circles anticlockwise'}" />
        </Grid>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="6" RowDefinitions="Auto,Auto">
          <TextBlock Classes="caption" Text="{l:Tr 'Mount mode'}" />
          <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:FlightDataViewModel.MountModes}" SelectedItem="{Binding SelectedMountMode}"
                    HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr 'Set Mount'}" Classes="accent" Command="{Binding SetMountModeCommand}"
                  IsEnabled="{Binding CanCommand}" ToolTip.Tip="{l:Tr 'How the gimbal is pointed'}" />
        </Grid>

        <UniformGrid Columns="3" ColumnSpacing="6" RowSpacing="6">
          <Button Content="{l:Tr 'Resume Mission'}" Command="{Binding ResumeMissionCommand}" IsEnabled="{Binding CanCommand}"
                  ToolTip.Tip="{l:Tr 'Carry on the mission from a waypoint (rewrites the mission on the vehicle)'}" />
          <Button Content="{l:Tr 'Abort Landing'}" Command="{Binding AbortLandingCommand}" IsEnabled="{Binding CanCommand}"
                  ToolTip.Tip="{l:Tr 'Go around: climb away from the landing'}" />
          <Button Content="{l:Tr 'Message'}" Command="{Binding SendLogMessageCommand}" IsEnabled="{Binding CanCommand}"
                  ToolTip.Tip="{l:Tr 'Send a text for the vehicle to write into its log'}" />
        </UniformGrid>

        <UniformGrid Columns="3" ColumnSpacing="6">
          <Button Content="{l:Tr 'Reboot'}" Command="{Binding RebootCommand}" IsEnabled="{Binding CanCommand}"
                  ToolTip.Tip="{l:Tr 'Restart the autopilot'}" />
          <Button Content="{l:Tr 'Restart Mission'}" Command="{Binding RestartMissionCommand}" IsEnabled="{Binding CanCommand}"
                  ToolTip.Tip="{l:Tr 'Start the mission again from the first item'}" />
          <ToggleButton Content="{l:Tr 'Set Home Alt'}" IsChecked="{Binding HomeAltOffsetActive, Mode=OneWay}"
                        Command="{Binding ToggleHomeAltCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" MinHeight="32"
                        ToolTip.Tip="{l:Tr 'Show altitude above sea level instead of above home'}" />
        </UniformGrid>
      </StackPanel>

      <!-- speech works without a vehicle too (settings, test) -->
      <Grid ColumnDefinitions="*,120" ColumnSpacing="6" Margin="8,0,8,8">
        <CheckBox Content="{l:Tr 'Speech'}" IsChecked="{Binding SpeechEnabled}" MinHeight="32"
                  ToolTip.Tip="{l:Tr 'Spoken announcements: mode, waypoint, arm/disarm, warnings, vehicle messages'}" />
        <Button Grid.Column="1" Content="{l:Tr 'Speech...'}" Command="{Binding OpenSpeechSettingsCommand}"
                ToolTip.Tip="{l:Tr 'Choose what is announced'}" />
      </Grid>
      <UniformGrid Columns="2" ColumnSpacing="6" Margin="8,0,8,8">
        <Button Content="{l:Tr 'Raw Sensor View'}" Command="{Binding OpenRawSensorsCommand}"
                ToolTip.Tip="{l:Tr 'Accelerometers, gyros, compasses, RC inputs and servo outputs'}" />
        <Button Content="{l:Tr 'Joystick'}" Command="{Binding OpenJoystickCommand}" ToolTip.Tip="{l:Tr 'SETUP > Joystick'}" />
      </UniformGrid>
      </StackPanel>
    </ScrollViewer>

    <!-- outcome of the last command -->
    <Border Grid.Row="1" Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="10,6">
      <Panel>
        <TextBlock Text="{l:Tr 'Connect to a vehicle to send commands.'}" Classes="muted" FontSize="12"
                   IsVisible="{Binding !IsConnected}" />
        <TextBlock Text="{l:TrBind {Binding ActionStatus}}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsConnected}"
                   Foreground="{DynamicResource Text}" Classes.err="{Binding ActionStatusIsError}">
          <TextBlock.Styles>
            <Style Selector="TextBlock.err">
              <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>
      </Panel>
    </Border>
  </Grid>
</UserControl>
