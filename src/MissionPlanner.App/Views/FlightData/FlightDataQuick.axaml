<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:fd="using:MissionPlanner.App.Controls.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightData.FlightDataQuick"
             x:DataType="vm:FlightDataViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- six large readouts, two columns by three rows; click one to show something else -->
    <ItemsControl ItemsSource="{Binding QuickTiles}" Margin="4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" Rows="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:QuickTile">
          <Button Classes="tile"
                  Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).EditQuickTileCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{l:Tr 'Click to choose what this tile shows'}">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:TrBind {Binding Label}}" FontSize="12.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="12" Classes="muted" Margin="6,0,0,0" />
              </Grid>
              <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Value, Converter={x:Static fd:QuickNumberConverter.Instance}}"
                           Foreground="{Binding Color, Converter={x:Static fd:HexBrushConverter.Instance}}"
                           FontSize="36" FontWeight="Bold" />
              </Viewbox>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- picker: which CurrentState value a tile shows -->
    <Border IsVisible="{Binding IsQuickPickerOpen}" Background="{DynamicResource Bg1}" Padding="8">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="{l:Tr 'Display this'}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center"
                     Text="{Binding EditingTile.Field.Display, FallbackValue=''}" />
        </Grid>
        <TextBox Grid.Row="1" x:Name="QuickSearch" PlaceholderText="{l:Tr 'Search values (alt, gps, ch3...)'}" Text="{Binding QuickFilter}" />
        <ListBox Grid.Row="2" x:Name="QuickList" ItemsSource="{Binding QuickFieldOptions}" Background="{DynamicResource Bg2}"
                 CornerRadius="6">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickField">
              <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="muted" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="{l:Tr 'Default'}" Command="{Binding ResetQuickTileCommand}" ToolTip.Tip="{l:Tr 'Show this tile\'s original value'}" />
          <Button Content="{l:Tr 'Cancel'}" Command="{Binding CloseQuickPickerCommand}" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</UserControl>
