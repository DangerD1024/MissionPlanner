<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightData.PrearmView"
             x:DataType="vm:PrearmViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18" RowSpacing="10">
    <TextBlock Classes="h2" Text="{l:Tr 'Pre-arm checks'}" />
    <TextBlock Grid.Row="1" Text="{l:TrBind {Binding Status}}" TextWrapping="Wrap" />
    <Border Grid.Row="2" Classes="card">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Problems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="3" Classes="accent" Content="{l:Tr 'Check again'}" Command="{Binding RunCommand}" HorizontalAlignment="Left" />
  </Grid>
</UserControl>
