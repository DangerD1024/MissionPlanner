<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.FlightData.AuxFunctionView"
             x:DataType="vm:AuxFunctionViewModel">

  <UserControl.Styles>
    <Style Selector="Button.pos">
      <Setter Property="Width" Value="50" />
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pin">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Width" Value="26" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pin.pinned">
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="8">
    <TextBox PlaceholderText="{l:Tr 'Search functions (e.g. camera, relay, 41)'}" Text="{Binding Filter}" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Margin="2,0,0,6" TextWrapping="Wrap"
               Text="{Binding SourceText}" />

    <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" Background="{DynamicResource Bg2}" CornerRadius="6">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="6,3" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AuxFunctionRow">
          <Grid ColumnDefinitions="Auto,34,*,Auto" ColumnSpacing="6">
            <Button Classes="pin" Classes.pinned="{Binding IsPinned}" Content="★" Command="{Binding TogglePinCommand}"
                    ToolTip.Tip="{l:Tr 'Pin to the top of the list'}" />
            <TextBlock Grid.Column="1" Text="{Binding IdText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                       TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3"
                        IsEnabled="{Binding $parent[ListBox].((vm:AuxFunctionViewModel)DataContext).CanCommand}">
              <Button Classes="pos" Classes.accent="{Binding IsLow}" Content="{l:Tr 'Low'}" Command="{Binding LowCommand}"
                      ToolTip.Tip="{l:Tr 'DO_AUX_FUNCTION: switch low'}" />
              <Button Classes="pos" Classes.accent="{Binding IsMiddle}" Content="{l:Tr 'Mid'}" Command="{Binding MiddleCommand}"
                      ToolTip.Tip="{l:Tr 'DO_AUX_FUNCTION: switch middle'}" />
              <Button Classes="pos" Classes.accent="{Binding IsHigh}" Content="{l:Tr 'High'}" Command="{Binding HighCommand}"
                      ToolTip.Tip="{l:Tr 'DO_AUX_FUNCTION: switch high'}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
