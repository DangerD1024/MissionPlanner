<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             x:Class="MissionPlanner.App.Views.FlightData.FlightDataStatus"
             x:DataType="vm:FlightDataViewModel">

  <!-- every CurrentState value; refreshed twice a second while this tab is showing -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="6">
    <TextBox PlaceholderText="Filter (e.g. gps, batt, ch1)" Text="{Binding StatusFilter}" Margin="0,0,0,6" />
    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="10,0,10,4">
      <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Classes="muted" />
      <TextBlock Grid.Column="1" Text="Value" FontSize="11" FontWeight="SemiBold" Classes="muted" />
    </Grid>
    <ListBox Grid.Row="2" ItemsSource="{Binding StatusEntries}" Background="{DynamicResource Bg2}" CornerRadius="6">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="10,2" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StatusEntry">
          <Grid ColumnDefinitions="*,*">
            <TextBlock Text="{Binding Name}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
