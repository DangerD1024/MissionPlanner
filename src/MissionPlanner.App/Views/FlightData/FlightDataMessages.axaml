<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.FlightData"
             x:Class="MissionPlanner.App.Views.FlightData.FlightDataMessages"
             x:DataType="vm:FlightDataViewModel">

  <Panel>
    <!-- newest first -->
    <ListBox ItemsSource="{Binding Messages}" Background="Transparent" Margin="2">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="8,3" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MessageLine">
          <Grid ColumnDefinitions="64,*">
            <TextBlock Text="{Binding TimeText}" Classes="muted" FontSize="12" FontFamily="monospace" VerticalAlignment="Top" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                 Classes.warn="{Binding IsWarning}">
              <SelectableTextBlock.Styles>
                <Style Selector="SelectableTextBlock.warn">
                  <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </Style>
              </SelectableTextBlock.Styles>
            </SelectableTextBlock>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Classes="muted" Text="No messages from the vehicle yet." HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !Messages.Count}" />
  </Panel>
</UserControl>
