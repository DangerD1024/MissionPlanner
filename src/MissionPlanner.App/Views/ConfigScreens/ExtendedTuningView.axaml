<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             xmlns:cs="using:MissionPlanner.App.Controls.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.ExtendedTuningView"
             x:DataType="vm:ExtendedTuningViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding WriteCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="18,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="h1" Text="{Binding Heading}" />
        <TextBlock Classes="muted" Text="{Binding VehicleText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
    </Border>
    <ProgressBar Height="3" MinHeight="3" CornerRadius="0" IsIndeterminate="True" Background="Transparent" VerticalAlignment="Top"
                 Foreground="{DynamicResource Accent}" IsVisible="{Binding IsBusy}" />

    <Panel Grid.Row="1">
      <cs:TuningCards IsVisible="{Binding HasCards}" />
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" MaxWidth="480"
                 TextAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </Grid>
</UserControl>
