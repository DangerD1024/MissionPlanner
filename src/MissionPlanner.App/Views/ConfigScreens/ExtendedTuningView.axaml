<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.ExtendedTuningView"
             x:DataType="vm:ExtendedTuningViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding WriteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Border.group">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10,12,8" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Width" Value="280" />
    </Style>
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="-6,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="Border.prow.modified">
      <Setter Property="Background" Value="#1f8cc63f" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.prow NumericUpDown">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Border.prow ComboBox, Border.prow DropDownButton">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="Background" Value="#33f0b429" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="CheckBox.bit">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <ProgressBar Height="3" MinHeight="3" CornerRadius="0" IsIndeterminate="True" Background="Transparent"
                 Foreground="{DynamicResource Accent}" IsVisible="{Binding IsBusy}" />

    <!-- header: title, lock and the write/refresh buttons -->
    <Border Grid.Row="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="18,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="h1" Text="{Binding Title}" />
            <TextBlock Classes="muted" Text="{Binding VehicleText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Intro}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <CheckBox Content="Lock pitch and roll values" IsChecked="{Binding LockRollPitch}" IsVisible="{Binding CanLockRollPitch}"
                    ToolTip.Tip="Editing a roll value sets its pitch twin to the same value, and back" Margin="0,0,8,0" />
          <Button Content="Discard edits" Command="{Binding DiscardEditsCommand}" IsVisible="{Binding HasPending}" />
          <Button Command="{Binding RefreshScreenCommand}" ToolTip.Tip="Read the values on this page from the vehicle again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              <TextBlock Text="Refresh Screen" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="Refresh Params" Command="{Binding RefreshParamsCommand}"
                  ToolTip.Tip="Download every parameter from the vehicle again" />
          <Button Classes="accent" Command="{Binding WriteCommand}" ToolTip.Tip="Write the edited values to the vehicle (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconUp}" />
              <TextBlock Text="Write Params" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="2">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}" Margin="18,12,6,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TuningSectionItem">
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" Classes="muted" FontSize="11.5" FontWeight="Bold" Margin="2,0,0,8"
                           LetterSpacing="0.6" />
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TuningGroupItem">
                      <Border Classes="group">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TuningParamItem">
                                <Border Classes="prow" Classes.modified="{Binding Editor.IsModified}">
                                  <Grid ColumnDefinitions="*,92,44">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent"
                                                ToolTip.Tip="{Binding Tip}">
                                      <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                        <Border Classes="badge" IsVisible="{Binding HasChangeNote}"
                                                ToolTip.Tip="{Binding ChangeNote, StringFormat='Changed in Copter 4.7: {0}'}">
                                          <TextBlock Text="4.7" />
                                        </Border>
                                      </StackPanel>
                                      <TextBlock Text="{Binding Name}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- number boxes step with the arrow keys; lists and bitmasks take the units column too -->
                                    <NumericUpDown Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding Editor.IsNumber}"
                                                   Value="{Binding Editor.NumericValue}" ShowButtonSpinner="False"
                                                   Minimum="{Binding Editor.Minimum}" Maximum="{Binding Editor.Maximum}"
                                                   Increment="{Binding Editor.Increment}" FormatString="0.#######"
                                                   IsEnabled="{Binding Editor.IsEditable}" HorizontalAlignment="Stretch"
                                                   ToolTip.Tip="{Binding Tip}" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                      <ComboBox IsVisible="{Binding Editor.IsOptions}" ItemsSource="{Binding Editor.Options}"
                                                SelectedItem="{Binding Editor.SelectedOption}" IsEnabled="{Binding Editor.IsEditable}"
                                                HorizontalAlignment="Stretch" MaxDropDownHeight="360" ToolTip.Tip="{Binding Tip}" />
                                      <DropDownButton IsVisible="{Binding Editor.IsBitmask}" IsEnabled="{Binding Editor.IsEditable}"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      Content="{Binding Editor.ValueText}" ToolTip.Tip="{Binding Tip}">
                                        <DropDownButton.Flyout>
                                          <Flyout Placement="BottomEdgeAlignedRight">
                                            <ItemsControl ItemsSource="{Binding Editor.Bits}" MaxWidth="420">
                                              <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                  <WrapPanel ItemWidth="200" />
                                                </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BitOption">
                                                  <CheckBox Classes="bit" IsChecked="{Binding IsChecked}"
                                                            ToolTip.Tip="{Binding Bit, StringFormat='bit {0}'}">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                  </CheckBox>
                                                </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                          </Flyout>
                                        </DropDownButton.Flyout>
                                      </DropDownButton>
                                    </Panel>

                                    <TextBlock Grid.Column="2" Text="{Binding Editor.Units}" Classes="muted" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding ShowUnits}" ToolTip.Tip="{Binding Editor.Units}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" MaxWidth="480"
                 TextAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </Grid>
</UserControl>
