<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             xmlns:loc="using:MissionPlanner.App.Core.Localization"
             xmlns:svc="using:MissionPlanner.App.Core.Services"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.ConfigScreens.PlannerSettingsView"
             x:DataType="vm:PlannerSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18" MaxWidth="900" HorizontalAlignment="Left" Width="900">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h1" Text="{l:Tr 'App Settings'}" />
        <Button Grid.Column="1" Content="{l:Tr 'Tools (Ctrl+F)'}" Command="{Binding OpenToolsCommand}"
                ToolTip.Tip="{l:Tr 'Extra tools from Mission Planner: calibration flags, bootloader, message rates, decoders, …'}" />
      </Grid>
      <TextBlock Classes="muted" Margin="0,2,0,16" FontSize="12.5"
                 Text="{l:Tr 'Settings of this application. Changes apply and are saved immediately.'}" />

      <!-- language -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{l:Tr 'Language'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Language'}" />
          <ComboBox Grid.Row="1" Grid.Column="1" Width="340" ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}" MaxDropDownHeight="520">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="loc:LanguageInfo">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding NativeName}" />
                  <TextBlock Classes="muted" Text="{Binding SecondaryName}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{l:Tr 'Applies immediately. Translations come from Mission Planner; text it has no translation for stays in English.'}" />
        </Grid>
      </Border>

      <!-- appearance -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{l:Tr 'Appearance'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Theme'}" />
          <ComboBox Grid.Row="1" Grid.Column="1" Width="340" ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:ThemeInfo">
                <TextBlock Text="{l:TrBind {Binding Name}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,6,0,0"
                     Text="{l:Tr 'Applies immediately. Mission Planner and High Contrast follow the WinForms app\'s themes.'}" />
        </Grid>
      </Border>

      <!-- map -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{l:Tr 'Map'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Default map'}" />
          <ComboBox Grid.Row="1" Grid.Column="1" Width="340" ItemsSource="{Binding MapProviders}"
                    SelectedItem="{Binding SelectedMapProvider}" MaxDropDownHeight="420" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,6,0,0"
                     Text="{l:Tr 'The imagery the map screens start with.'}" />
        </Grid>
      </Border>

      <!-- logs -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="4" Classes="h2" Text="{l:Tr 'Logs'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Log folder'}" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LogDirectory}" />
          <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseLogDirectoryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconFolder}" />
              <TextBlock Text="{l:Tr 'Browse'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" Content="{l:Tr 'Default'}" Command="{Binding ResetLogDirectoryCommand}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" FontSize="12"
                     Foreground="{DynamicResource Warn}" Text="{l:TrBind {Binding LogDirectoryError}}" TextWrapping="Wrap"
                     IsVisible="{Binding LogDirectoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </Border>

      <!-- parameter documentation -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{l:Tr 'Parameter documentation'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Status'}" VerticalAlignment="Top" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DocsStatus}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:Tr 'Downloaded'}" VerticalAlignment="Top" Margin="0,8,12,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,8,0,0"
                     Text="{Binding DocsFiles}" TextWrapping="Wrap" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
            <Button Classes="accent" Command="{Binding UpdateParamDocsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                <TextBlock Text="{l:Tr 'Update parameter docs now'}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsUpdatingDocs}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- telemetry rates -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="{l:Tr 'Telemetry rates'}" Margin="0,0,0,4" />
          <TextBlock Classes="muted" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="{l:Tr 'How often the vehicle sends each group of messages. Applies now when connected, and to every new connection.'}" />
          <ItemsControl ItemsSource="{Binding Rates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamRateSetting">
                <Grid ColumnDefinitions="180,160,*" Margin="0,3">
                  <TextBlock Classes="label" Text="{l:TrBind {Binding Label}}" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}"
                            SelectedItem="{Binding Selected}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RateChoice">
                        <TextBlock Text="{l:TrBind {Binding Label}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- units -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <Grid.Resources>
            <DataTemplate x:Key="UnitTemplate" x:DataType="vm:UnitChoice">
              <TextBlock Text="{l:TrBind {Binding Label}}" />
            </DataTemplate>
          </Grid.Resources>
          <TextBlock Grid.ColumnSpan="3" Classes="h2" Text="{l:Tr 'Units'}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr 'Distance'}" />
          <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3" ItemTemplate="{StaticResource UnitTemplate}"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.DistanceChoices}" SelectedItem="{Binding DistanceUnit}" />
          <TextBlock Grid.Row="2" Classes="label" Text="{l:Tr 'Altitude'}" />
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3" ItemTemplate="{StaticResource UnitTemplate}"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.DistanceChoices}" SelectedItem="{Binding AltitudeUnit}" />
          <TextBlock Grid.Row="3" Classes="label" Text="{l:Tr 'Speed'}" />
          <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3" ItemTemplate="{StaticResource UnitTemplate}"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.SpeedChoices}" SelectedItem="{Binding SpeedUnit}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="12" Margin="0,8,0,0"
                     Text="{Binding UnitsExample}" />
        </Grid>
      </Border>

      <!-- about (was the HELP screen): version, data and log folders, Linux menu entry -->
      <ContentControl Content="{Binding About}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
