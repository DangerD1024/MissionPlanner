<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.PlannerSettingsView"
             x:DataType="vm:PlannerSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18" MaxWidth="900" HorizontalAlignment="Left" Width="900">
      <TextBlock Classes="h1" Text="Planner" />
      <TextBlock Classes="muted" Margin="0,2,0,16" FontSize="12.5"
                 Text="Settings of this application. Changes apply and are saved immediately." />

      <!-- map -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="Map" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="Default map" />
          <ComboBox Grid.Row="1" Grid.Column="1" Width="340" ItemsSource="{Binding MapProviders}"
                    SelectedItem="{Binding SelectedMapProvider}" MaxDropDownHeight="420" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,6,0,0"
                     Text="The imagery the map screens start with." />
        </Grid>
      </Border>

      <!-- logs -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="4" Classes="h2" Text="Logs" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="Log folder" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LogDirectory}" />
          <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseLogDirectoryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconFolder}" />
              <TextBlock Text="Browse" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" Content="Default" Command="{Binding ResetLogDirectoryCommand}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" FontSize="12"
                     Foreground="{StaticResource Warn}" Text="{Binding LogDirectoryError}" TextWrapping="Wrap"
                     IsVisible="{Binding LogDirectoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </Border>

      <!-- parameter documentation -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="Parameter documentation" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="Status" VerticalAlignment="Top" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DocsStatus}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Classes="label" Text="Downloaded" VerticalAlignment="Top" Margin="0,8,12,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="12" Margin="0,8,0,0"
                     Text="{Binding DocsFiles}" TextWrapping="Wrap" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
            <Button Classes="accent" Command="{Binding UpdateParamDocsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                <TextBlock Text="Update parameter docs now" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsUpdatingDocs}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- telemetry rates -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Telemetry rates" Margin="0,0,0,4" />
          <TextBlock Classes="muted" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="How often the vehicle sends each group of messages. Applies now when connected, and to every new connection." />
          <ItemsControl ItemsSource="{Binding Rates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamRateSetting">
                <Grid ColumnDefinitions="180,160,*" Margin="0,3">
                  <TextBlock Classes="label" Text="{Binding Label}" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}"
                            SelectedItem="{Binding Selected}" />
                  <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- units -->
      <Border Classes="card">
        <Grid ColumnDefinitions="180,260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="3" Classes="h2" Text="Units" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Classes="label" Text="Distance" />
          <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.DistanceChoices}" SelectedItem="{Binding DistanceUnit}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Altitude" />
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.DistanceChoices}" SelectedItem="{Binding AltitudeUnit}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Speed" />
          <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,3"
                    ItemsSource="{x:Static vm:PlannerSettingsViewModel.SpeedChoices}" SelectedItem="{Binding SpeedUnit}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="12" Margin="0,8,0,0"
                     Text="{Binding UnitsExample}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
