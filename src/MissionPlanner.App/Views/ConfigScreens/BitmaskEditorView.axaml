<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.ConfigScreens.BitmaskEditorView"
             x:DataType="vm:BitmaskEditorViewModel">

  <UserControl.Styles>
    <Style Selector="CheckBox.bit">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="18,16">
    <StackPanel Spacing="4" Margin="0,0,0,12">
      <TextBlock Classes="h2" Text="{Binding DisplayName}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" FontSize="12" Text="{Binding Name}" />
      <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"
                 Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="12,8">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding Documented}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="275" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BitmaskBit">
                <CheckBox Classes="bit" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding BitText}">
                  <TextBlock Text="{l:TrBind {Binding Label}}" TextTrimming="CharacterEllipsis" />
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted" Text="{l:Tr 'No bit of this parameter is documented.'}" IsVisible="{Binding HasNoDocumentation}" />

          <StackPanel Spacing="4" IsVisible="{Binding HasUndocumented}" Margin="0,8,0,0">
            <TextBlock FontSize="12" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                       Text="{l:Tr 'Set on the vehicle but not documented (kept unless you clear them):'}" />
            <ItemsControl ItemsSource="{Binding Undocumented}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="275" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BitmaskBit">
                  <CheckBox Classes="bit" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding BitText}">
                    <TextBlock Text="{l:TrBind {Binding Label}}" TextTrimming="CharacterEllipsis" />
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="{l:Tr 'All'}" Command="{Binding SelectAllCommand}" ToolTip.Tip="{l:Tr 'Tick every documented bit'}" />
        <Button Content="{l:Tr 'None'}" Command="{Binding ClearAllCommand}" ToolTip.Tip="{l:Tr 'Clear every documented bit'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ValueText, StringFormat='Value {0}'}" />
        <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="12" Text="{Binding OriginalText}"
                   IsVisible="{Binding IsChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="{l:Tr 'Cancel'}" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="{l:Tr 'Use value'}" MinWidth="110" HorizontalContentAlignment="Center"
                Command="{Binding ApplyCommand}" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
