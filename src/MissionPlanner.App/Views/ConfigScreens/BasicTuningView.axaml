<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.BasicTuningView"
             x:DataType="vm:BasicTuningViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding WriteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Border.slider">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.slider.modified">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="Padding" Value="14,12,16,12" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Background" Value="{DynamicResource Bg3}" />
    </Style>
    <Style Selector="Border.chip.modified">
      <Setter Property="Background" Value="#2e8cc63f" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="#33f0b429" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <ProgressBar Height="3" MinHeight="3" CornerRadius="0" IsIndeterminate="True" Background="Transparent"
                 Foreground="{DynamicResource Accent}" IsVisible="{Binding IsBusy}" />

    <!-- header: title and the write/refresh buttons -->
    <Border Grid.Row="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="18,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="h1" Text="{Binding Title}" />
            <TextBlock Classes="muted" Text="{Binding VehicleText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Intro}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Discard edits" Command="{Binding DiscardEditsCommand}" IsVisible="{Binding HasPending}" />
          <Button Command="{Binding RefreshScreenCommand}" ToolTip.Tip="Read the values on this page from the vehicle again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              <TextBlock Text="Refresh Screen" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding WriteCommand}" ToolTip.Tip="Write the edited values to the vehicle (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconUp}" />
              <TextBlock Text="Write Params" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="2">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}" Margin="18,14,18,4" MaxWidth="960" HorizontalAlignment="Left">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TuningSliderSection">
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" Classes="muted" FontSize="11.5"
                           FontWeight="Bold" Margin="2,0,0,8" LetterSpacing="0.6" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TuningSliderItem">
                      <Border Classes="slider" Classes.modified="{Binding IsModified}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                          <!-- title and parameter -->
                          <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding Name}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding HasChangeNote}"
                                    ToolTip.Tip="{Binding ChangeNote, StringFormat='Changed in Copter 4.7: {0}'}">
                              <TextBlock Text="4.7" />
                            </Border>
                          </StackPanel>

                          <!-- value box -->
                          <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Top">
                            <TextBlock Text="{Binding OriginalText}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                            <NumericUpDown Width="130" Value="{Binding BoxValue}" Minimum="{Binding BoxMinimum}"
                                           Maximum="{Binding BoxMaximum}" Increment="{Binding BoxIncrement}"
                                           FormatString="0.#######" ToolTip.Tip="{Binding Tip}" />
                            <TextBlock Text="{Binding Units}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                       Width="44" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Units}" />
                          </StackPanel>

                          <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" Classes="muted"
                                     FontSize="12.5" Margin="0,4,16,0" />

                          <!-- slider: positions 0..1000, the view-model maps and snaps them -->
                          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LeftText}" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                                       MinWidth="40" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding Position}"
                                    SmallChange="{Binding SmallChange}" LargeChange="{Binding LargeChange}"
                                    IsDirectionReversed="{Binding Reversed}" Margin="10,0" ToolTip.Tip="{Binding ValueText}" />
                            <TextBlock Grid.Column="2" Text="{Binding RightText}" Classes="muted" FontSize="11.5"
                                       VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                          </Grid>

                          <!-- values set with the slider -->
                          <StackPanel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding HasLinks}" Margin="0,4,0,0">
                            <TextBlock Text="Also sets" Classes="muted" FontSize="11" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Links}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TuningLinkItem">
                                  <Border Classes="chip" Classes.modified="{Binding IsModified}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                      <TextBlock Text="{Binding MultiplierText}" Classes="muted" />
                                      <TextBlock Text="{Binding ValueText}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" MaxWidth="480"
                 TextAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </Grid>
</UserControl>
