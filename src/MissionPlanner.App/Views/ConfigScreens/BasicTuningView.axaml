<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             xmlns:cs="using:MissionPlanner.App.Controls.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.BasicTuningView"
             x:DataType="vm:BasicTuningViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding WriteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- copter: Mission Planner's ConfigSimplePids range controls as cards -->
    <Style Selector="Border.scard">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.scard.modified">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.info">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="18,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="h1" Text="{Binding Heading}" />
        <TextBlock Classes="muted" Text="{Binding VehicleText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
    </Border>
    <ProgressBar Height="3" MinHeight="3" CornerRadius="0" IsIndeterminate="True" Background="Transparent" VerticalAlignment="Top"
                 Foreground="{DynamicResource Accent}" IsVisible="{Binding IsBusy}" />

    <Panel Grid.Row="1">
      <!-- planes and rovers: ConfigArduplane / ConfigArdurover -->
      <cs:TuningCards IsVisible="{Binding HasCards}" />

      <!-- copters: sliders that write as they move, and what they set -->
      <ScrollViewer IsVisible="{Binding HasSliders}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,14" MaxWidth="680" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding Sliders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TuningSliderItem">
                <Border Classes="scard" Classes.modified="{Binding IsModified}">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
                      <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted" FontSize="12.5" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                      <NumericUpDown Width="150" Value="{Binding BoxValue}" Minimum="{Binding BoxMinimum}"
                                     Maximum="{Binding BoxMaximum}" Increment="{Binding BoxIncrement}"
                                     FormatString="0.#######" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}" />
                      <!-- positions 0..1000; the view-model maps and snaps them -->
                      <Slider Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding Position}" Margin="14,0,4,0"
                              SmallChange="{Binding SmallChange}" LargeChange="{Binding LargeChange}"
                              IsDirectionReversed="{Binding Reversed}" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding ValueText}" />
                      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" Margin="16,-6,6,0">
                        <TextBlock Text="{Binding LeftText}" Classes="muted" FontSize="11.5" />
                        <TextBlock Grid.Column="1" Text="{Binding RightText}" Classes="muted" FontSize="11.5"
                                   HorizontalAlignment="Right" />
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="info">
            <SelectableTextBlock Text="{Binding InfoText}" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" Margin="2,6,0,0" />
        </StackPanel>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" MaxWidth="480"
                 TextAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </Grid>
</UserControl>
