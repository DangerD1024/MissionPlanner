<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             xmlns:cs="using:MissionPlanner.App.Controls.ConfigScreens"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.ConfigScreens.UserParamsView"
             x:DataType="vm:UserParamsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding WriteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <StyleInclude Source="avares://MissionPlanner.App/Controls/ConfigScreens/ParamGridStyles.axaml" />

    <Style Selector="Button.row">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.row Path.icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="ListBox.picker ListBoxItem">
      <Setter Property="Padding" Value="10,4" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <ProgressBar Height="3" MinHeight="3" CornerRadius="0" IsIndeterminate="True" Background="Transparent"
                 Foreground="{DynamicResource Accent}" IsVisible="{Binding IsBusy}" />

    <!-- header: title and the write button, as on Standard / Advanced Params -->
    <Border Grid.Row="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Padding="18,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="h1" Text="{l:Tr 'User Params'}" />
          <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                     Text="{l:Tr 'Your own short list of parameters. Add them from the list on the right; changes are written when you press Write Params.'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{l:Tr 'Discard edits'}" Command="{Binding DiscardEditsCommand}" IsVisible="{Binding HasPending}" />
          <Button Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Tr 'Read every parameter from the vehicle again'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              <TextBlock Text="{l:Tr 'Refresh Params'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding WriteCommand}" ToolTip.Tip="{l:Tr 'Write the edited values to the vehicle (Ctrl+S)'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconUp}" />
              <TextBlock Text="{l:Tr 'Write Params'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="{l:TrBind {Binding StatusText}}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,280">
      <Grid RowDefinitions="*,Auto">
        <Panel>
          <DataGrid x:Name="ParamsGrid" Classes="params" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                    AutoGenerateColumns="False" RowHeight="44" HeadersVisibility="Column" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                    GridLinesVisibility="Horizontal" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{l:Tr 'Name'}" Width="190" MinWidth="140" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <StackPanel Margin="10,0,4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding NameTip}">
                      <TextBlock Classes="name" Classes.modified="{Binding IsModified}" Text="{Binding Name}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DisplayName}" FontSize="11" Classes="muted"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="{l:Tr 'Value'}" Width="210" MinWidth="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <cs:ParamValueCell />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <TextBox Text="{Binding EditText}" VerticalAlignment="Center" Margin="2,0" MinHeight="30"
                             Padding="6,4" FontSize="12.5" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="{l:Tr 'Units'}" Width="70" MinWidth="44" Binding="{Binding Units}" IsReadOnly="True" />

              <DataGridTemplateColumn Header="{l:Tr 'Options'}" Width="160" MinWidth="100" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding OptionsText}" FontSize="11.5"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding OptionsTipOrNull}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="{l:Tr 'Desc'}" Width="*" MinWidth="120" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Description}" FontSize="11.5"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DescriptionTip}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="" Width="96" MinWidth="96" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ParamRow">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                      <Button Classes="row" ToolTip.Tip="{l:Tr 'Move up'}"
                              Command="{Binding $parent[UserControl].((vm:UserParamsViewModel)DataContext).MoveUpCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconUp}" />
                      </Button>
                      <Button Classes="row" ToolTip.Tip="{l:Tr 'Move down'}"
                              Command="{Binding $parent[UserControl].((vm:UserParamsViewModel)DataContext).MoveDownCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconDown}" />
                      </Button>
                      <Button Classes="row" ToolTip.Tip="{l:Tr 'Remove from the list'}"
                              Command="{Binding $parent[UserControl].((vm:UserParamsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconDelete}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" MaxWidth="420"
                     TextWrapping="Wrap" TextAlignment="Center" Text="{l:TrBind {Binding EmptyText}}" IsVisible="{Binding IsEmpty}" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted"
                     Text="{l:Tr 'Loading parameters...'}" IsVisible="{Binding IsLoading}" />
        </Panel>
        <TextBlock Grid.Row="1" Margin="14,6" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding MissingText}" IsVisible="{Binding MissingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>

      <!-- the picker -->
      <Border Grid.Column="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">
          <TextBlock FontSize="11" FontWeight="Bold" Classes="muted" Text="{l:Tr 'ADD PARAMETERS'}" />
          <TextBox x:Name="PickerBox" Grid.Row="1" Margin="0,8,0,4" Text="{Binding PickerSearch}"
                   PlaceholderText="{l:Tr 'Search name or description'}" />
          <TextBlock Grid.Row="2" Classes="muted" FontSize="11.5" Text="{Binding PickerSummary}" Margin="0,0,0,6" />
          <ListBox x:Name="PickerList" Grid.Row="3" Classes="picker" Background="Transparent"
                   ItemsSource="{Binding PickerResults}" SelectedItem="{Binding SelectedPick}"
                   ToolTip.Tip="{l:Tr 'Double-click, or select and press Add'}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ParamPickItem">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                  <TextBlock Text="{Binding DisplayName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasDisplayName}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Spacing="8" Margin="0,8,0,0">
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{l:Tr 'Add to my list'}" Command="{Binding AddCommand}" CommandParameter="{Binding SelectedPick}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{l:Tr 'Restore default list'}"
                    Command="{Binding RestoreDefaultsCommand}"
                    ToolTip.Tip="{l:Tr 'Mission Planner\'s list: the RC switch options (CHn_OPT / RCn_OPTION)'}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
