<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.ConfigScreens"
             x:Class="MissionPlanner.App.Views.ConfigScreens.ParamCompareView"
             x:DataType="vm:ParamCompareViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Spacing="4" Margin="0,0,0,12">
      <TextBlock Classes="h2" Text="{Binding FileName, StringFormat='Compare with {0}'}" />
      <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="Ticked values are taken over as edits; nothing is written until you press Write Params." />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="0">
      <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" HeadersVisibility="Column"
                RowHeight="34" CanUserSortColumns="True" CanUserResizeColumns="True" BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Use" Width="64" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ParamCompareRow">
                <CheckBox IsChecked="{Binding Use}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Center" MinWidth="0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name}" IsReadOnly="True" />
          <DataGridTextColumn Header="Current" Width="110" Binding="{Binding CurrentText}" IsReadOnly="True" />
          <DataGridTemplateColumn Header="From file" Width="110" SortMemberPath="FromFile" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ParamCompareRow">
                <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding FromFileText}"
                           Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <CheckBox Content="Select all" IsChecked="{Binding AllChecked}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Use ticked values" MinWidth="140" HorizontalContentAlignment="Center"
                Command="{Binding ApplyCommand}" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
