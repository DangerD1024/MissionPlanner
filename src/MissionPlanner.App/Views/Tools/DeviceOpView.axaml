<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.DeviceOpView"
             x:DataType="vm:DeviceOpViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <tv:ToolHeader />
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,12,Auto">
          <TextBlock Text="{l:Tr 'Bus'}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding BusTypes}" SelectedItem="{Binding BusType}" Width="160" />
          <TextBlock Grid.Row="2" Text="{l:Tr 'SPI device name'}" VerticalAlignment="Center" IsVisible="{Binding IsSpi}" />
          <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpiName}" Width="220" HorizontalAlignment="Left" IsVisible="{Binding IsSpi}" />
          <TextBlock Grid.Row="2" Text="{l:Tr 'I2C bus number'}" VerticalAlignment="Center" IsVisible="{Binding !IsSpi}" />
          <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding Bus}" Minimum="0" Maximum="15" FormatString="0" Width="160"
                         HorizontalAlignment="Left" IsVisible="{Binding !IsSpi}" />
          <TextBlock Grid.Row="4" Text="{l:Tr 'I2C address'}" VerticalAlignment="Center" IsVisible="{Binding !IsSpi}" />
          <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Address}" Width="160" HorizontalAlignment="Left" IsVisible="{Binding !IsSpi}" />
          <TextBlock Grid.Row="6" Text="{l:Tr 'First register'}" VerticalAlignment="Center" />
          <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Register}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="8" Text="{l:Tr 'Bytes'}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="8" Grid.Column="2" Value="{Binding Count}" Minimum="1" Maximum="128" FormatString="0" Width="160"
                         HorizontalAlignment="Left" />
          <Button Grid.Row="10" Grid.Column="2" Classes="accent" Content="{l:Tr 'Read'}" Command="{Binding ReadCommand}"
                  IsEnabled="{Binding CanCommand}" />
        </Grid>
      </Border>
      <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" MinHeight="200"
               FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
