<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.FftView"
             x:DataType="vm:FftViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel.sources Button">
      <Setter Property="IsEnabled" Value="{Binding !IsBusy}" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">
    <tv:ToolHeader />
    <Border Grid.Row="1" Classes="card" Margin="0,16,0,12">
      <StackPanel Spacing="10">
        <WrapPanel Classes="sources">
          <Button Classes="accent" Content="{l:Tr 'IMU batch sample…'}" Command="{Binding BatchSamplerCommand}"
                  ToolTip.Tip="{l:Tr 'ISBH/ISBD messages: the raw sensor data of the batch sampler (INS_LOG_BAT_MASK).'}" />
          <Button Content="{l:Tr 'All IMUs (ACC, GYR)…'}" Command="{Binding AccGyrCommand}" />
          <Button Content="{l:Tr 'All IMUs (IMU messages)…'}" Command="{Binding ImuMessagesCommand}" />
          <Button Content="{l:Tr 'IMU 1 (ACC1, GYR1)…'}" Command="{Binding FirstImuCommand}" />
          <Button Content="{l:Tr '16-bit mono WAV…'}" Command="{Binding WavCommand}" />
          <Button Content="{l:Tr 'Cancel'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" IsEnabled="True" />
        </WrapPanel>
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,6">
            <TextBlock Classes="muted" Text="{l:Tr 'Bins'}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Bins}" Minimum="4" Maximum="16" Increment="1" FormatString="0" Width="110" />
            <TextBlock Classes="muted" Text="{Binding BinsText}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,6">
            <TextBlock Classes="muted" Text="{l:Tr 'Start frequency'}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding StartFrequency}" Minimum="0" Maximum="10000" Increment="1" FormatString="0.#" Width="110" />
            <TextBlock Classes="muted" Text="Hz" VerticalAlignment="Center" />
          </StackPanel>
          <CheckBox Content="{l:Tr 'Magnitude (not dB)'}" IsChecked="{Binding Magnitude}" Margin="0,0,20,6" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,6"
                      ToolTip.Tip="{l:Tr 'Used for a raw 16-bit file without a WAV header.'}">
            <TextBlock Classes="muted" Text="{l:Tr 'Raw file rate'}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding WavSampleRate}" Minimum="1" Maximum="1000000" Increment="1000" FormatString="0" Width="130" />
            <TextBlock Classes="muted" Text="Hz" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="Cursor" Classes="muted" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                   Text="{l:Tr 'Point at a graph to read the frequency and rpm.'}" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2">
      <UniformGrid x:Name="Graphs" Columns="3" />
    </ScrollViewer>
  </Grid>
</UserControl>
