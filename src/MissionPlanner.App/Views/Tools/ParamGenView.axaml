<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.ParamGenView"
             x:DataType="vm:ParamGenViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="720" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock TextWrapping="Wrap"
                     Text="{l:Tr 'Download fetches the documentation of every vehicle type (and of the firmware release the connected vehicle runs) from autotest.ardupilot.org.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:Tr 'Download now'}" Command="{Binding DownloadCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{l:Tr 'Generate from source…'}" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="{l:Tr 'Mission Planner\'s Param gen: reads the parameter comments from ArduPilot\'s source code'}" />
            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Width="720" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:Tr 'Files'}" />
          <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" />
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParamDocsFile">
                <Grid ColumnDefinitions="*,160,80" Margin="0,2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Updated}" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
