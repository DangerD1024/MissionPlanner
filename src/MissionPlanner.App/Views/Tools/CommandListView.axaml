<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.CommandListView"
             x:DataType="vm:CommandListViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1300" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{l:Tr 'Command ID'}" VerticalAlignment="Center" />
            <TextBox Text="{Binding NewId}" Width="90" PlaceholderText="217" />
            <TextBox Text="{Binding NewName}" Width="220" IsVisible="{Binding NeedsName}" />
            <Button Classes="accent" Content="{l:Tr 'Add'}" Command="{Binding AddCommand}" />
            <TextBlock Text="{l:TrBind {Binding NewIdName}}" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="60,220,*,*,*,*,*,*,*,Auto" ColumnSpacing="6">
            <TextBlock Classes="muted" FontSize="12" Text="ID" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{l:Tr 'Name'}" />
            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="P1" />
            <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="P2" />
            <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="P3" />
            <TextBlock Grid.Column="5" Classes="muted" FontSize="12" Text="P4" />
            <TextBlock Grid.Column="6" Classes="muted" FontSize="12" Text="P5 (X)" />
            <TextBlock Grid.Column="7" Classes="muted" FontSize="12" Text="P6 (Y)" />
            <TextBlock Grid.Column="8" Classes="muted" FontSize="12" Text="P7 (Z)" />
          </Grid>
          <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{l:Tr 'No extra commands: the PLAN grid offers the commands of mavcmd.xml.'}" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlannerCommandRow">
                <Grid ColumnDefinitions="60,220,*,*,*,*,*,*,*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Name}" IsReadOnly="{Binding IsKnown}" />
                  <TextBox Grid.Column="2" Text="{Binding P1}" />
                  <TextBox Grid.Column="3" Text="{Binding P2}" />
                  <TextBox Grid.Column="4" Text="{Binding P3}" />
                  <TextBox Grid.Column="5" Text="{Binding P4}" />
                  <TextBox Grid.Column="6" Text="{Binding P5}" />
                  <TextBox Grid.Column="7" Text="{Binding P6}" />
                  <TextBox Grid.Column="8" Text="{Binding P7}" />
                  <Button Grid.Column="9" Content="−" Width="30" ToolTip.Tip="{l:Tr 'Remove'}"
                          Command="{Binding $parent[UserControl].((vm:CommandListViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:Tr 'Save'}" Command="{Binding SaveCommand}" />
            <Button Content="{l:Tr 'Reload'}" Command="{Binding LoadCommand}" />
            <TextBlock Foreground="{DynamicResource Warn}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" Text="{l:Tr 'Not saved'}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
