<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.PacketDecoderView"
             x:DataType="vm:PacketDecoderViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Grid ColumnDefinitions="*,16,*" MinHeight="420">
        <TextBox Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap" Watermark="fd 09 00 00 2a 01 01 00 00 00 …" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
        <SelectableTextBlock Grid.Column="2" Text="{Binding Output}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
