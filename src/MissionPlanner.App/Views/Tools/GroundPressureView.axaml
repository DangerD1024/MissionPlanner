<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.GroundPressureView"
             x:DataType="vm:GroundPressureViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="620" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" />
          <TextBlock Classes="h2" Text="{l:Tr 'QNH'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding Qnh}" Width="160" Watermark="101325" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Pa or hPa'}" />
            <Button Content="{l:Tr 'Set QNH'}" Command="{Binding SetQnhCommand}" IsEnabled="{Binding HasParam}" />
          </StackPanel>
          <TextBlock Classes="h2" Text="{l:Tr 'Adjust the reported height'}" Margin="0,8,0,0" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:Tr 'Moves the barometer altitude by about this many metres (11.1 Pa per metre) from the value read when the page opened. Use at your own risk.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown Value="{Binding OffsetMetres}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" Width="140" />
            <TextBlock Text="m" VerticalAlignment="Center" />
            <Button Content="{l:Tr 'Apply'}" Command="{Binding ApplyOffsetCommand}" IsEnabled="{Binding HasParam}" />
            <Button Content="{l:Tr 'Reset'}" Command="{Binding ResetOffsetCommand}" IsEnabled="{Binding HasParam}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
