<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.MessageIntervalView"
             x:DataType="vm:MessageIntervalViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="620" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" FontSize="12" Text="{l:Tr 'Message'}" />
          <AutoCompleteBox ItemsSource="{Binding Messages}" Text="{Binding Message}" FilterMode="ContainsOrdinal"
                           Watermark="ATTITUDE" MinimumPrefixLength="1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown Value="{Binding RateHz}" Minimum="-1" Maximum="400" Increment="1" FormatString="0.##" Width="140" />
            <TextBlock Text="Hz" VerticalAlignment="Center" />
            <Button Classes="accent" Content="{l:Tr 'Set'}" Command="{Binding SetCommand}" IsEnabled="{Binding CanCommand}" />
            <Button Content="{l:Tr 'Set every message…'}" Command="{Binding SetAllCommand}" IsEnabled="{Binding CanCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
