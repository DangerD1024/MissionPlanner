<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.MapCacheView"
             x:DataType="vm:MapCacheViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">
    <tv:ToolHeader Margin="0,0,0,12" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
      <TextBlock Text="{Binding Total}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="{l:Tr 'Open folder'}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="{l:Tr 'Refresh'}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
    </Grid>
    <Border Grid.Row="2" Classes="card" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Folders}" Margin="12,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapCacheFolders+Folder">
              <Grid ColumnDefinitions="*,110,110,Auto,Auto" Margin="0,4">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Tiles, StringFormat='{}{0} tiles'}" VerticalAlignment="Center" Classes="muted" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="{l:Tr 'Remove 30+ days'}" Margin="8,0,0,0"
                        Command="{Binding $parent[UserControl].((vm:MapCacheViewModel)DataContext).RemoveOldCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="4" Content="{l:Tr 'Remove all'}" Margin="8,0,0,0"
                        Command="{Binding $parent[UserControl].((vm:MapCacheViewModel)DataContext).RemoveAllCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
