<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.RemoteLoggerView"
             x:DataType="vm:RemoteLoggerViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="620" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Text="{Binding BackendWarning}"
                     IsVisible="{Binding BackendWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:TrBind {Binding StartStopText}}" Command="{Binding StartStopCommand}" />
            <Button Content="{l:Tr 'Open in the log browser'}" Command="{Binding OpenInBrowserCommand}" IsEnabled="{Binding CanOpen}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding HasFile}" Spacing="4">
            <SelectableTextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Progress}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
