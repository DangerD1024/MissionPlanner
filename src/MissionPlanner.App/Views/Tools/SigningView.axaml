<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.SigningView"
             x:DataType="vm:SigningViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="760" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:Tr 'Keys'}" />
          <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{l:Tr 'No keys yet: add one below.'}" />
          <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SigningKeyRow">
                <Grid ColumnDefinitions="160,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding KeyText}" VerticalAlignment="Center" Classes="muted" FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{l:Tr 'in use'}" Foreground="{DynamicResource Info}" VerticalAlignment="Center" IsVisible="{Binding InUse}" />
                  <Button Grid.Column="3" Content="{l:Tr 'Use'}" ToolTip.Tip="{l:Tr 'Send this key to the vehicle and sign the link with it'}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SigningViewModel)DataContext).CanCommand}"
                          Command="{Binding $parent[UserControl].((vm:SigningViewModel)DataContext).UseCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="4" Content="{l:Tr 'Remove'}"
                          Command="{Binding $parent[UserControl].((vm:SigningViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{l:Tr 'Disable signing'}" Command="{Binding DisableCommand}" IsEnabled="{Binding CanCommand}"
                    ToolTip.Tip="{l:Tr 'Clear the vehicle\'s key (SETUP_SIGNING with an empty key) and stop signing'}" />
            <TextBlock Text="{Binding LinkText}" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Width="760" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:Tr 'Add a key'}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Text="{l:Tr 'Name'}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding NewName}" PlaceholderText="{l:Tr 'A friendly name'}" />
            <TextBlock Grid.Row="1" Text="{l:Tr 'Passphrase'}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Passphrase}" PasswordChar="•" RevealPassword="False" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StrengthText}" Classes="muted" FontSize="12" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:Tr 'Use numbers, lower case, upper case and symbols, 12 or more characters with at least 2 of each. The same passphrase always makes the same key, so it can be entered again on another computer.'}" />
          <Button Classes="accent" Content="{l:Tr 'Add key'}" Command="{Binding AddKeyCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
