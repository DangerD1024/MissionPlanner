<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.ShpToPolyView"
             x:DataType="vm:ShpToPolyViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">
    <tv:ToolHeader Margin="0,0,0,12" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Classes="accent" Content="{l:Tr 'Convert a shapefile…'}" Command="{Binding ConvertCommand}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
    <TextBox Grid.Row="2" Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
  </Grid>
</UserControl>
