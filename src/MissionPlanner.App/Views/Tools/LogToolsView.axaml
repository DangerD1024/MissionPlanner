<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.LogToolsView"
             x:DataType="vm:LogToolsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.tool">
      <Setter Property="Width" Value="340" />
      <Setter Property="Margin" Value="0,0,14,14" />
    </Style>
    <Style Selector="Border.tool Button">
      <Setter Property="IsEnabled" Value="{Binding !IsBusy}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16">
      <tv:ToolHeader />
      <WrapPanel>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Google Earth and GPX'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'The flight path of a .bin, .log or .tlog as .kml (Google Earth) and .gpx (maps, photo tools).'}" />
            <Button Classes="accent" Content="{l:Tr 'Export KML and GPX…'}" Command="{Binding KmlCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Binary to text'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'Converts a .bin DataFlash log to a text .log anyone can read.'}" />
            <Button Content="{l:Tr 'Convert .bin to .log…'}" Command="{Binding BinToLogCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Split a log'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'Cuts a large DataFlash log into pieces that each open on their own.'}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding SplitPieces}" Minimum="2" Maximum="100" Increment="1" FormatString="0" Width="120" />
              <TextBlock Classes="muted" Text="{l:Tr 'pieces'}" VerticalAlignment="Center" />
              <Button Content="{l:Tr 'Split…'}" Command="{Binding SplitCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'DashWare'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'A CSV of the chosen messages for DashWare video overlays.'}" />
            <TextBox Text="{Binding DashWareTypes}" />
            <Button Content="{l:Tr 'Create DashWare CSV…'}" Command="{Binding DashWareCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Anonymise'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'A copy of a log with the location moved, to share it publicly. Check the result before sharing.'}" />
            <Button Content="{l:Tr 'Anonymise a log…'}" Command="{Binding AnonymiseCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Sort logs'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'Moves the logs of a folder into one folder per vehicle type and system ID.'}" />
            <Button Content="{l:Tr 'Sort a folder…'}" Command="{Binding SortCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'GPS corrections'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'Saves the RTCM correction data a telemetry log sent to the vehicle (GPS_INJECT_DATA, GPS_RTCM_DATA).'}" />
            <Button Content="{l:Tr 'Extract from a .tlog…'}" Command="{Binding ExtractGpsInjectCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card tool">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Remote DataFlash log'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr 'Records the vehicle log over the telemetry link into the log folder (the vehicle needs LOG_BACKEND_TYPE with MAVLink).'}" />
            <Button Content="{l:TrBind {Binding RemoteLogText}}" Command="{Binding ToggleRemoteLogCommand}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
               FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
