<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.MavSerialPassView"
             x:DataType="vm:MavSerialPassViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="620" HorizontalAlignment="Left">
        <StackPanel>
          <StackPanel IsEnabled="{Binding CanEditSettings}">
            <TextBlock Classes="label" Text="{l:Tr 'Vehicle port'}" />
            <ComboBox ItemsSource="{x:Static vm:MavSerialPassViewModel.Devices}" SelectedItem="{Binding Device}" Width="170" />
            <TextBlock Classes="label" Text="{l:Tr 'Baud rate (0: leave as the autopilot set it)'}" />
            <ComboBox ItemsSource="{x:Static vm:MavSerialPassViewModel.Bauds}" SelectedItem="{Binding Baud}" Width="170" />
            <TextBlock Classes="label" Text="{l:Tr 'TCP port on this computer'}" />
            <NumericUpDown Value="{Binding TcpPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="170" HorizontalAlignment="Left" />
          </StackPanel>

          <Button Classes="accent" Margin="0,16,0,0" Content="{l:TrBind {Binding StartStopText}}" Command="{Binding StartStopCommand}" />

          <StackPanel IsVisible="{Binding IsRunning}" Margin="0,10,0,0" Spacing="4">
            <TextBlock Text="{Binding ClientText}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding TrafficText}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="{l:Tr 'In u-center: Receiver > Connection > Network connection, tcp://127.0.0.1:500. The data goes over the telemetry link, so a fast link (USB) works best.'}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
