<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.ProximityView"
             x:DataType="vm:ProximityViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20" RowSpacing="12">
    <tv:ToolHeader />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="{l:Tr 'Zoom in'}" Command="{Binding ZoomInCommand}" ToolTip.Tip="{l:Tr 'Smaller radius (+ key, or the mouse wheel)'}" />
      <Button Content="{l:Tr 'Zoom out'}" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:Tr 'Larger radius (- key, or the mouse wheel)'}" />
      <Button Content="{l:Tr 'Vehicle smaller'}" Command="{Binding SmallerCommand}" ToolTip.Tip="[" />
      <Button Content="{l:Tr 'Vehicle larger'}" Command="{Binding LargerCommand}" ToolTip.Tip="]" />
      <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Classes="muted" />
      <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding VerticalText}" VerticalAlignment="Center" Classes="muted" />
    </StackPanel>
    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <tv:ProximityRadar x:Name="Radar" Frame="{Binding Frame}" Focusable="True"
                         Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}" MinHeight="300" />
    </Border>
  </Grid>
</UserControl>
