<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.SwarmFollowLeaderView"
             x:DataType="vm:SwarmFollowLeaderViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:Tr 'Pick the leader in the list and press Set leader, then Start. The others fly where the leader has been.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="{l:Tr 'Distance between vehicles (m)'}" />
            <NumericUpDown Value="{Binding FollowDistance}" Minimum="0.5" Maximum="100" Increment="0.5" FormatString="0.#" Width="130" />
            <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="12" Text="{l:TrBind {Binding TrailText}}" />
          </StackPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{l:Tr 'Set leader'}" Command="{Binding SetLeaderCommand}" IsEnabled="{Binding HasSelection}" />
            <Button Classes="accent" Content="{l:TrBind {Binding StartText}}" Command="{Binding StartStopCommand}" IsEnabled="{Binding HasLeader}" />
            <Button Content="{l:Tr 'Clear track'}" Command="{Binding ClearTrailCommand}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{l:Tr 'Arm (excluding leader)'}" Command="{Binding ArmCommand}" IsEnabled="{Binding CanCommand}" />
            <Button Content="{l:Tr 'Disarm (excluding leader)'}" Command="{Binding DisarmCommand}" IsEnabled="{Binding CanCommand}" />
            <Button Content="{l:Tr 'Takeoff'}" Command="{Binding TakeoffCommand}" IsEnabled="{Binding CanCommand}" />
            <Button Classes="danger" Content="{l:Tr 'Land (all)'}" Command="{Binding LandCommand}" IsEnabled="{Binding CanCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <tv:SwarmVehicleList />
    </StackPanel>
  </ScrollViewer>
</UserControl>
