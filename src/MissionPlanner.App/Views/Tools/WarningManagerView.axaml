<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.WarningManagerView"
             x:DataType="vm:WarningManagerViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1300" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:Tr 'Add warning'}" Command="{Binding AddCommand}" />
            <Button Content="{l:Tr 'Save'}" Command="{Binding SaveCommand}" />
            <Button Content="{l:Tr 'Reload'}" Command="{Binding ReloadCommand}" ToolTip.Tip="{l:Tr 'Discard unsaved changes and read the file again'}" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Warn}"
                       IsVisible="{Binding IsDirty}" Text="{l:Tr 'Not saved: the changes are checked now but are lost when the app closes.'}" />
          </StackPanel>

          <Grid ColumnDefinitions="40,110,190,80,110,120,*,70,70,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{l:Tr 'Tile colour'}" />
            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{l:Tr 'Value'}" />
            <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="{l:Tr 'Condition'}" />
            <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="{l:Tr 'Limit'}" />
            <TextBlock Grid.Column="5" Classes="muted" FontSize="12" Text="{l:Tr 'Colour'}" />
            <TextBlock Grid.Column="6" Classes="muted" FontSize="12" Text="{l:Tr 'Text to say'}" />
            <TextBlock Grid.Column="7" Classes="muted" FontSize="12" Text="{l:Tr 'Repeat (s)'}" />
            <TextBlock Grid.Column="8" Classes="muted" FontSize="12" Text="{l:Tr 'Now'}" />
          </Grid>

          <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{l:Tr 'No warnings yet: Add warning makes one.'}" />

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WarningRowViewModel">
                <Grid ColumnDefinitions="40,110,190,80,110,120,*,70,70,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource Danger}" IsVisible="{Binding IsActive}" HorizontalAlignment="Left"
                           ToolTip.Tip="{l:Tr 'The warning holds now'}" />
                  <TextBlock Text="{l:Tr 'and'}" IsVisible="{Binding IsChild}" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="muted" />
                  <CheckBox Grid.Column="1" IsChecked="{Binding Rule.IsColoring}" IsVisible="{Binding IsTop}"
                            Content="{l:Tr 'Quick tile'}" ToolTip.Tip="{l:Tr 'Colour the value\'s Quick tile instead of speaking'}" />
                  <AutoCompleteBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).Fields}"
                                   Text="{Binding Rule.Field}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
                  <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).Conditions}"
                            SelectedItem="{Binding Rule.Condition}" />
                  <NumericUpDown Grid.Column="4" Value="{Binding Rule.Value}" Minimum="-99999" Maximum="99999" Increment="1" FormatString="0.##" />
                  <ComboBox Grid.Column="5" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).Colors}"
                            SelectedItem="{Binding Rule.Color}" IsVisible="{Binding Rule.IsColoring}" />
                  <TextBox Grid.Column="6" Text="{Binding Rule.Text}" IsVisible="{Binding Rule.IsSpeech}" IsEnabled="{Binding IsTop}" />
                  <NumericUpDown Grid.Column="7" Value="{Binding Rule.RepeatSeconds}" Minimum="0" Maximum="3600" Increment="1" FormatString="0"
                                 IsVisible="{Binding Rule.IsSpeech}" IsEnabled="{Binding IsTop}" />
                  <TextBlock Grid.Column="8" Text="{Binding CurrentText}" VerticalAlignment="Center" Classes="muted" />
                  <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="4">
                    <Button Content="+" Width="30" ToolTip.Tip="{l:Tr 'Add a condition that must hold as well'}"
                            Command="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).AddConditionCommand}" CommandParameter="{Binding}" />
                    <Button Content="−" Width="30" ToolTip.Tip="{l:Tr 'Remove'}"
                            Command="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                    <Button Content="{l:Tr 'Test'}" IsVisible="{Binding IsTop}" ToolTip.Tip="{l:Tr 'Say the text now with the current value'}"
                            Command="{Binding $parent[UserControl].((vm:WarningManagerViewModel)DataContext).TestCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:Tr 'Warnings are checked twice a second while a vehicle is connected, and spoken when speech is on (DATA > speech settings). The file is shared with Mission Planner:'}" />
          <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding FilePath}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
