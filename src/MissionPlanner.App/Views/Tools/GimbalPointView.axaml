<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.GimbalPointView"
             x:DataType="vm:GimbalPointViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <tv:ToolHeader />
      <Border Classes="card" Width="720" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:Tr 'The camera angles come from the mount (MOUNT_STATUS or the gimbal attitude), or from the mount servo outputs and their angle limits. The line of sight is followed over the terrain (SRTM) for up to 1 km.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:Tr 'Find the camera target'}" Command="{Binding ProjectCommand}" IsEnabled="{Binding CanCommand}" />
            <Button Content="{l:TrBind {Binding TrackText}}" Command="{Binding TrackCommand}" IsEnabled="{Binding IsConnected}" />
          </StackPanel>
          <TextBlock Text="{Binding AnglesText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding VehicleText}" TextWrapping="Wrap" />
          <StackPanel Spacing="4" IsVisible="{Binding Target, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="h2" Text="{l:Tr 'Camera target'}" />
            <SelectableTextBlock Text="{Binding TargetText}" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
