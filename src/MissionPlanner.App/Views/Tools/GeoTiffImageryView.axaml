<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Tools"
             xmlns:maps="using:MissionPlanner.App.Core.Maps"
             xmlns:tv="using:MissionPlanner.App.Views.Tools"
             xmlns:controls="using:MissionPlanner.App.Controls"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Tools.GeoTiffImageryView"
             x:DataType="vm:GeoTiffImageryViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">
    <tv:ToolHeader Margin="0,0,0,12" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
      <TextBlock Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="muted" />
      <Button Grid.Column="1" Classes="accent" Content="{l:Tr 'Choose folder…'}" Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="{l:Tr 'Clear'}" Command="{Binding ClearImagesCommand}" IsEnabled="{Binding HasImages}" Margin="8,0,0,0" />
      <TextBlock Grid.Column="3" Text="{l:Tr 'Opacity'}" VerticalAlignment="Center" Margin="16,0,8,0" />
      <Slider Grid.Column="4" Minimum="5" Maximum="100" Value="{Binding Opacity}" Width="140" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="360,12,*">
      <Grid RowDefinitions="*,Auto">
        <Border Classes="card" Padding="0">
          <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="maps:GeoTiffImage">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                  <TextBlock Text="{Binding Crs}" Classes="muted" FontSize="12" />
                  <TextBlock Classes="muted" FontSize="12">
                    <Run Text="{Binding Width}" /><Run Text=" × " /><Run Text="{Binding Height}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <TextBox Grid.Row="1" Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Margin="0,10,0,0"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="11" />
      </Grid>
      <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
        <controls:MapView x:Name="Map" Provider="{Binding Provider}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
