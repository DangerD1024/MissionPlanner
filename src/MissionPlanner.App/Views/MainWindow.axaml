<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MissionPlanner.App.Core.ViewModels"
        xmlns:l="using:MissionPlanner.App.Localization"
        xmlns:upd="using:MissionPlanner.App.Core.Updates"
        x:Class="MissionPlanner.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Icon="/Assets/mpdesktop.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg2}">

  <!-- Mission Planner's hotkeys (MainV2.ProcessCmdKey); a page's own binding for the same keys wins -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F12" Command="{Binding ConnectHotkeyCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Data}" />
    <KeyBinding Gesture="F3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Plan}" />
    <KeyBinding Gesture="F4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Config}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshParamsHotkeyCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Tools}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding CommitParamsHotkeyCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding OutputsHotkeyCommand}" />
    <KeyBinding Gesture="Ctrl+X" Command="{Binding MapCacheHotkeyCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding DeviceOpHotkeyCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="72,Auto,*">

    <!-- top bar -->
    <Border Grid.Row="0" Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0">

        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsData, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Data}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconData}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_flightdata_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'DATA'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsPlan, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Plan}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconPlan}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_flightplan_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'PLAN'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsSetup, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Setup}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconSetup}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_initialsetup_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'SETUP'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsConfig, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Config}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconConfig}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_tuningconfig_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'CONFIG'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsSimulation, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Simulation}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconSim}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_simulation_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'SIMULATION'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsSettings, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Settings}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconSettings}" VerticalAlignment="Center" />
              </Panel>
              <TextBlock Text="{l:Tr 'SETTINGS'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsHelp, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Screen.Help}">
            <StackPanel Spacing="2">
              <Panel HorizontalAlignment="Center" Height="30">
                <Path Classes="icon navicon" Data="{StaticResource IconHelp}" VerticalAlignment="Center" IsVisible="{DynamicResource ShowVectorIcons}" />
                <Image Source="/Assets/MissionPlannerIcons/light_help_icon.png" Width="33" Height="30" IsVisible="{DynamicResource ShowOriginalIcons}" />
              </Panel>
              <TextBlock Text="{l:Tr 'HELP'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                         MaxWidth="112" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- wordmark -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,24,0" Spacing="6" ClipToBounds="True" FlowDirection="LeftToRight">
          <TextBlock Text="MISSION" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text}" />
          <TextBlock Text="PLANNER" FontSize="17" FontWeight="Light" Foreground="{DynamicResource Accent}" />
        </StackPanel>

        <!-- link: port + baud, vehicle underneath -->
        <Grid Grid.Column="2" x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
              RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center"
              Margin="0,0,10,0">
          <ComboBox Width="250" Height="28" MinHeight="28" Padding="8,2" FontSize="12"
                    ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                    IsEnabled="{Binding CanEditLink}" ToolTip.Tip="{l:Tr 'Port'}" />
          <ComboBox Grid.Column="1" Width="104" Height="28" MinHeight="28" Padding="8,2" FontSize="12" Margin="6,0,0,0"
                    ItemsSource="{Binding Bauds}" SelectedItem="{Binding SelectedBaud}"
                    IsEnabled="{Binding CanEditLink}" IsVisible="{Binding IsSerial}" ToolTip.Tip="{l:Tr 'Baud rate'}" />
          <Button Grid.Column="2" Width="28" Height="28" MinHeight="28" Padding="1" Margin="6,0,0,0" Background="Transparent"
                  Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding CanEditLink}" ToolTip.Tip="{l:Tr 'Refresh ports'}">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
          </Button>
          <ComboBox Grid.Row="1" Grid.ColumnSpan="3" Height="28" MinHeight="28" Padding="8,2" FontSize="12" Margin="0,6,0,0"
                    HorizontalAlignment="Stretch" PlaceholderText="{l:Tr 'vehicle'}"
                    ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"
                    IsVisible="{Binding ShowVehicles}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,10,0,0" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource Danger}" Text="{Binding StaleText}" IsVisible="{Binding IsStale}"
                     ToolTip.Tip="{l:Tr 'Nothing is arriving from the vehicle. The link is kept and resumes by itself when data returns (TCP is reopened automatically); press Disconnect to stop trying.'}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,8,0,0" FontSize="11" Classes="muted"
                     Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}" TextTrimming="CharacterEllipsis" MaxWidth="390" />
          <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"
                      IsVisible="{Binding CanEditLink}">
            <CheckBox IsChecked="{Binding AutoConnect}" MinHeight="24" FontSize="12" Content="{l:Tr 'Auto-connect'}"
                      ToolTip.Tip="{l:Tr 'Connect automatically to any autopilot plugged in by USB or sending MAVLink on UDP 14550'}" />
            <TextBlock Text="{l:TrBind {Binding AutoConnectStatus}}" FontSize="11" Classes="muted" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
          </StackPanel>
        </Grid>

        <Button Grid.Column="3" x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                Command="{Binding ToggleConnectCommand}" Width="96" Height="54" Padding="4"
                Background="Transparent" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <Panel HorizontalAlignment="Center" Height="30">
              <Panel IsVisible="{DynamicResource ShowVectorIcons}">
                <Path Classes="icon navicon" Data="{StaticResource IconConnect}" IsVisible="{Binding !IsConnected}"
                      Stroke="{DynamicResource Accent}" VerticalAlignment="Center" />
                <Path Classes="icon navicon" Data="{StaticResource IconDisconnect}" IsVisible="{Binding IsConnected}"
                      Stroke="{DynamicResource Danger}" VerticalAlignment="Center" />
              </Panel>
              <!-- Mission Planner's plugs: red while disconnected, green while connected -->
              <Panel IsVisible="{DynamicResource ShowOriginalIcons}">
                <Image Source="/Assets/MissionPlannerIcons/light_connect_icon.png" Width="33" Height="30"
                       IsVisible="{Binding !IsConnected}" />
                <Image Source="/Assets/MissionPlannerIcons/light_disconnect_icon.png" Width="33" Height="30"
                       IsVisible="{Binding IsConnected}" />
              </Panel>
            </Panel>
            <TextBlock Text="{l:TrBind {Binding ConnectText}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- connect progress -->
    <ProgressBar Grid.Row="1" x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                 Height="3" MinHeight="3" CornerRadius="0" IsVisible="{Binding IsBusy}"
                 IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="Transparent" />

    <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

    <!-- a newer release (UpdateViewModel): download it, then install or show it -->
    <Border Grid.Row="2" x:DataType="vm:ShellViewModel" Classes="apptoast" IsVisible="{Binding Updates.IsBannerVisible}"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Padding="14,8" CornerRadius="6" BorderThickness="0,0,0,3">
      <StackPanel x:DataType="upd:UpdateViewModel" DataContext="{Binding Updates}" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding BannerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="{l:Tr 'Download'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent" />
          <Button Content="{l:Tr 'Cancel'}" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
          <Button Content="{l:TrBind {Binding InstallText}}" Command="{Binding InstallCommand}" IsVisible="{Binding IsDownloaded}" Classes="accent" />
          <Button Content="{l:Tr 'Release notes'}" Command="{Binding OpenReleasePageCommand}" />
          <Button Content="{l:Tr 'Later'}" Command="{Binding LaterCommand}" />
          <Button Content="{l:Tr 'Skip this version'}" Command="{Binding SkipCommand}" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" Height="6" MinHeight="6" IsVisible="{Binding IsDownloading}" />
        <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" MaxWidth="760" />
      </StackPanel>
    </Border>

    <!-- AppServices.Notify: outcomes that need no answer ("12 parameters saved"); goes away by itself -->
    <Border Grid.Row="2" Classes="apptoast" Classes.error="{Binding ToastIsError}" Classes.warn="{Binding ToastIsWarning}"
            IsVisible="{Binding IsToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,20" Padding="14,10" MaxWidth="480" CornerRadius="6" BorderThickness="4,0,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{l:TrBind {Binding ToastText}}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="✕" Padding="6,0" Margin="10,0,0,0" Background="Transparent"
                VerticalAlignment="Center" Command="{Binding DismissToastCommand}" />
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.apptoast">
      <Setter Property="Background" Value="{DynamicResource Overlay}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #50000000" />
    </Style>
    <Style Selector="Border.apptoast.warn">
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="Border.apptoast.error">
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>
  </Window.Styles>

</Window>
