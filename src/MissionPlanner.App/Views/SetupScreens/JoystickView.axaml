<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             x:Class="MissionPlanner.App.Views.SetupScreens.JoystickView"
             x:DataType="vm:JoystickViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.button.on">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.button.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Fill" Value="{DynamicResource Bg3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.on">
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="ProgressBar.axis">
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Minimum" Value="-32768" />
      <Setter Property="Maximum" Value="32767" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.pwm">
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Minimum" Value="800" />
      <Setter Property="Maximum" Value="2200" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1280" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Joystick" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Fly with a joystick or gamepad: map its axes to RC channels and its buttons to actions, then enable to send RC overrides to the vehicle at 25 Hz. Mappings are saved per device." />
      </StackPanel>

      <Border Classes="banner" IsVisible="{Binding BackendMissing}" Background="#30f0b429">
        <TextBlock Text="{Binding BackendText}" TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="480,16,*">
        <!-- device -->
        <Border Classes="card" Padding="18" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="Device" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="11.5" Text="{Binding BackendText}" IsVisible="{Binding !BackendMissing}"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,8,Auto">
              <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch"
                        PlaceholderText="No joystick" IsEnabled="{Binding IsIdle}" />
              <Button Grid.Column="2" ToolTip.Tip="Look for joysticks again" Command="{Binding RefreshDevicesCommand}" Padding="6">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="18" Height="18" />
              </Button>
            </Grid>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding DeviceText}" TextWrapping="Wrap" />
            <StackPanel Spacing="6" IsEnabled="{Binding IsIdle}">
              <CheckBox Content="Send MANUAL__CONTROL instead of RC overrides" IsChecked="{Binding ManualControl}"
                        ToolTip.Tip="x = pitch, y = roll, z = throttle, r = yaw and the first 16 buttons, per the MAVLink definition" />
              <CheckBox Content="Elevons (mix roll and pitch on channels 1 and 2)" IsChecked="{Binding Elevons}" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,12,*">
              <Button Classes="accent" MinWidth="110" Padding="16,8" HorizontalContentAlignment="Center" Content="{Binding EnableText}"
                      Command="{Binding ToggleSendingCommand}" IsVisible="{Binding IsIdle}" IsEnabled="{Binding HasDevice}" />
              <Button Classes="danger" MinWidth="110" Padding="16,8" HorizontalContentAlignment="Center" Content="{Binding EnableText}"
                      Command="{Binding ToggleSendingCommand}" IsVisible="{Binding IsSending}" />
              <TextBlock Grid.Column="2" Text="{Binding SendText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Info}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding LastActionText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- live input -->
        <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Live input" />
            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasDevice}" Text="Select a joystick to see its axes and buttons." />
            <ItemsControl ItemsSource="{Binding Axes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AxisReading">
                  <Grid ColumnDefinitions="64,*,64" Margin="0,2">
                    <TextBlock Classes="label" Text="{Binding Label}" FontSize="12" />
                    <ProgressBar Grid.Column="1" Classes="axis" Value="{Binding Value}" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="monospace" FontSize="12" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ButtonStates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ButtonReading">
                  <Border Classes="button" Classes.on="{Binding IsPressed}">
                    <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Hats}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HatReading">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="{Binding Label}" FontSize="12" />
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- channels -->
      <Border Classes="card" Padding="18" IsVisible="{Binding HasDevice}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="RC channels" />
            <CheckBox Grid.Column="1" Content="Show channels 9–16" IsChecked="{Binding ShowAllChannels}" />
          </Grid>
          <Grid ColumnDefinitions="110,180,72,80,128,128,*,56,60" Margin="0,4,0,2">
            <TextBlock Classes="caption" Text="CHANNEL" />
            <TextBlock Grid.Column="1" Classes="caption" Text="INPUT" />
            <TextBlock Grid.Column="3" Classes="caption" Text="REVERSE" />
            <TextBlock Grid.Column="4" Classes="caption" Text="EXPO %" />
            <TextBlock Grid.Column="5" Classes="caption" Text="TRIM µs" />
            <TextBlock Grid.Column="6" Classes="caption" Text="OUTPUT" Margin="8,0,0,0" />
            <TextBlock Grid.Column="7" Classes="caption" Text="PWM" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="8" Classes="caption" Text="VEHICLE" HorizontalAlignment="Right" ToolTip.Tip="What the vehicle reports for the channel (RC_CHANNELS)" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelRowViewModel">
                <Grid ColumnDefinitions="110,180,72,80,128,128,*,56,60" Margin="0,2" IsVisible="{Binding IsVisible}">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding $parent[UserControl].((vm:JoystickViewModel)DataContext).IsIdle}" />
                  <Button Grid.Column="2" Classes="small" Content="Detect" Margin="6,0,0,0" Command="{Binding DetectCommand}"
                          IsEnabled="{Binding !IsDetecting}" />
                  <CheckBox Grid.Column="3" IsChecked="{Binding Reverse}" Margin="14,0,0,0" />
                  <NumericUpDown Grid.Column="4" Value="{Binding Expo}" Minimum="-100" Maximum="100" Increment="5" FormatString="0" Margin="0,0,6,0" />
                  <NumericUpDown Grid.Column="5" Value="{Binding Trim}" Minimum="-500" Maximum="500" Increment="5" FormatString="0" Margin="0,0,6,0" />
                  <ProgressBar Grid.Column="6" Classes="pwm" Value="{Binding Output}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="7" Text="{Binding OutputText}" FontFamily="monospace" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="8" Text="{Binding VehicleText}" FontFamily="monospace" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource Muted}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- buttons -->
      <Border Classes="card" Padding="18" IsVisible="{Binding HasDevice}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Buttons" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Actions run on a button press while sending is enabled (the relay action also on release). Button axes drive channels set to 'Button axis'." />
          <ItemsControl ItemsSource="{Binding ButtonRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ButtonRowViewModel">
                <Grid ColumnDefinitions="36,120,72,24,200,*" Margin="0,3">
                  <TextBlock Text="{Binding Title}" Classes="label" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding SelectedButton}" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="2" Classes="small" Content="Detect" Margin="6,0,0,0" Command="{Binding DetectCommand}" IsEnabled="{Binding !IsDetecting}" />
                  <Ellipse Grid.Column="3" Classes="dot" Classes.on="{Binding IsPressed}" HorizontalAlignment="Center" />
                  <ComboBox Grid.Column="4" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" HorizontalAlignment="Stretch" />
                  <WrapPanel Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="140" IsVisible="{Binding UsesMode}"
                              PlaceholderText="mode" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" IsVisible="{Binding HasP1}">
                      <TextBlock Classes="label" Text="{Binding P1Label}" FontSize="12" />
                      <NumericUpDown Value="{Binding P1}" Width="132" Increment="1" Minimum="-100000" Maximum="100000" FormatString="0.##" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" IsVisible="{Binding HasP2}">
                      <TextBlock Classes="label" Text="{Binding P2Label}" FontSize="12" />
                      <NumericUpDown Value="{Binding P2}" Width="132" Increment="1" Minimum="-100000" Maximum="100000" FormatString="0.##" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" IsVisible="{Binding HasP3}">
                      <TextBlock Classes="label" Text="{Binding P3Label}" FontSize="12" />
                      <NumericUpDown Value="{Binding P3}" Width="132" Increment="1" Minimum="-100000" Maximum="100000" FormatString="0.##" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasP4}">
                      <TextBlock Classes="label" Text="{Binding P4Label}" FontSize="12" />
                      <NumericUpDown Value="{Binding P4}" Width="132" Increment="1" Minimum="-100000" Maximum="100000" FormatString="0.##" />
                    </StackPanel>
                  </WrapPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="Auto,10,Auto,12,*" IsVisible="{Binding HasDevice}">
        <Button Classes="accent" Content="Save profile" Command="{Binding SaveCommand}" Padding="14,6" />
        <Button Grid.Column="2" Content="Clear mappings…" Command="{Binding ResetProfileCommand}" Padding="14,6" IsEnabled="{Binding IsIdle}" />
        <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="{Binding ProfileText}" VerticalAlignment="Center" TextWrapping="Wrap"
                   ToolTip.Tip="{Binding ProfilePath}" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
