<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:hwv="using:MissionPlanner.App.Views.SetupScreens.Hardware"
             x:Class="MissionPlanner.App.Views.SetupScreens.SerialPortsView"
             x:DataType="vm:SerialPortsViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,20">
    <hwv:PageHeader Description="What each serial port talks to and how fast. Choosing a protocol applies Mission Planner's recommended baud rate and options for it." />

    <Border Grid.Row="1" Margin="0,12,0,0" Background="#33e5534b" BorderBrush="{StaticResource Danger}" BorderThickness="1"
            CornerRadius="6" Padding="12,8" IsVisible="{Binding TooManyMavlink}">
      <TextBlock Text="{Binding MavlinkWarning}" TextWrapping="Wrap" />
    </Border>

    <!-- column headings -->
    <Grid Grid.Row="2" Margin="12,14,12,6" ColumnDefinitions="150,1.6*,1*,1.6*,1*">
      <TextBlock Classes="muted" Text="Port" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Classes="muted" Text="Protocol" FontWeight="SemiBold" Margin="6,0" />
      <TextBlock Grid.Column="2" Classes="muted" Text="Baud" FontWeight="SemiBold" Margin="6,0" />
      <TextBlock Grid.Column="3" Classes="muted" Text="Options" FontWeight="SemiBold" Margin="6,0" />
      <TextBlock Grid.Column="4" Classes="muted" Text="RTS/CTS" FontWeight="SemiBold" Margin="6,0"
                 IsVisible="{Binding HasFlowControl}" />
    </Grid>

    <Border Grid.Row="3" Classes="card" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Ports}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SerialPortRow">
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid ColumnDefinitions="150,1.6*,1*,1.6*,1*">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UartName}" Classes="muted" FontSize="12" IsVisible="{Binding HasUartName}" />
                  </StackPanel>
                  <hwv:ParamEditor Grid.Column="1" DataContext="{Binding Protocol}" Margin="6,0" />
                  <hwv:ParamEditor Grid.Column="2" DataContext="{Binding Baud}" Margin="6,0" />
                  <hwv:ParamEditor Grid.Column="3" DataContext="{Binding Options}" Margin="6,0" />
                  <hwv:ParamEditor Grid.Column="4" DataContext="{Binding RtsCts}" Margin="6,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="6">
      <TextBlock Text="{Binding RuleNote}" IsVisible="{Binding HasRuleNote}" Foreground="{StaticResource Info}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" Text="{Binding RebootNote, StringFormat='Note: {0}'}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
