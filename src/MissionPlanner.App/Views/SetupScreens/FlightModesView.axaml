<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:hwv="using:MissionPlanner.App.Views.SetupScreens.Hardware"
             x:Class="MissionPlanner.App.Views.SetupScreens.FlightModesView"
             x:DataType="vm:FlightModesViewModel">

  <UserControl.Styles>
    <Style Selector="Border.slot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Border.slot.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.slot.active TextBlock.slottitle">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
      <hwv:PageHeader Description="The mode for each position of the flight mode switch. The highlighted row is the position the switch is in now. Changes are written when you press Save Modes." />

      <Grid ColumnDefinitions="*,Auto">
        <Border Classes="card">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FlightModeSlot">
                  <Border Classes="slot" Classes.active="{Binding IsActive}">
                    <Grid ColumnDefinitions="120,220,Auto,Auto,*">
                      <TextBlock Classes="slottitle" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <hwv:ParamEditor Grid.Column="1" DataContext="{Binding Mode}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="2" Margin="16,0,0,0" Content="Simple" IsChecked="{Binding Simple}"
                                IsEnabled="{Binding SimpleAllowed}"
                                IsVisible="{Binding $parent[ItemsControl].((vm:FlightModesViewModel)DataContext).ShowSimple}" />
                      <CheckBox Grid.Column="3" Margin="12,0,0,0" Content="Super Simple" IsChecked="{Binding SuperSimple}"
                                IsEnabled="{Binding SimpleAllowed}"
                                IsVisible="{Binding $parent[ItemsControl].((vm:FlightModesViewModel)DataContext).ShowSimple}" />
                      <TextBlock Grid.Column="4" Classes="muted" Text="{Binding Band}" VerticalAlignment="Center"
                                 HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="110" TextAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,14,0,4">
              <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}" Padding="18,8" />
              <Button Content="Undo changes" Command="{Binding RevertCommand}" IsEnabled="{Binding HasChanges}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="Unsaved changes" IsVisible="{Binding HasChanges}"
                         Foreground="{DynamicResource Info}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Width="260" Margin="16,0,0,0" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="CURRENT MODE" FontSize="11" FontWeight="Bold" />
            <TextBlock Classes="h1" Text="{Binding CurrentMode}" FontSize="24" />
            <TextBlock Classes="muted" Text="CURRENT PWM" FontSize="11" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBlock Text="{Binding SwitchText}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       IsVisible="{Binding ShowSimple}"
                       Text="Simple and Super Simple make the sticks act relative to the take-off heading or home position; only some modes support them." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
