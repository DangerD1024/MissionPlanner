<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:hwv="using:MissionPlanner.App.Views.SetupScreens.Hardware"
             xmlns:hwc="using:MissionPlanner.App.Controls.SetupScreens.Hardware"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.SetupScreens.FrameTypeView"
             x:DataType="vm:FrameTypeViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Width" Value="128" />
      <Setter Property="Height" Value="128" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tile.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.tile.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.tile.selected TextBlock.tilelabel">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:FrameTile">
      <Button Classes="tile" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
              ToolTip.Tip="{l:TrBind {Binding Label}}">
        <Grid RowDefinitions="*,Auto">
          <hwc:MotorLayoutView Layout="{Binding Layout}" IsDimmed="{Binding !IsSelected}"
                               IsVisible="{Binding HasLayout}" Margin="4" />
          <TextBlock Grid.Row="0" Text="{l:TrBind {Binding Label}}" IsVisible="{Binding !HasLayout}" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Grid.Row="1" Classes="tilelabel" Text="{l:TrBind {Binding Label}}" IsVisible="{Binding HasLayout}"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <Grid ColumnDefinitions="*,Auto" Margin="24,20">
      <StackPanel Spacing="14">
        <hwv:PageHeader Description="Choose how your vehicle is built. Each choice is written to the autopilot straight away (after you confirm) and takes effect after a reboot." />

        <!-- FRAME_CLASS / FRAME_TYPE -->
        <StackPanel Spacing="8" IsVisible="{Binding IsClassType}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Frame class'}" />
            <TextBlock Classes="muted" Text="{Binding ClassParam}" VerticalAlignment="Bottom" FontSize="12" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource TileTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Classes="h2" Text="{l:Tr 'Frame type'}" />
            <TextBlock Classes="muted" Text="{Binding TypeParam}" VerticalAlignment="Bottom" FontSize="12" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Types}" ItemTemplate="{StaticResource TileTemplate}" IsVisible="{Binding HasTypes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Classes="muted" Text="{l:TrBind {Binding TypesNote}}" IsVisible="{Binding !HasTypes}" />
        </StackPanel>

        <!-- old copters: FRAME -->
        <StackPanel Spacing="8" IsVisible="{Binding IsLegacy}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="h2" Text="{l:Tr 'Frame'}" />
            <TextBlock Classes="muted" Text="{l:Tr 'FRAME'}" VerticalAlignment="Bottom" FontSize="12" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding LegacyFrames}" ItemTemplate="{StaticResource TileTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- the frame the vehicle has now -->
      <Border Grid.Column="1" Classes="card" Width="300" Margin="20,0,0,0" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" Text="{l:Tr 'CURRENT FRAME'}" FontSize="11" FontWeight="Bold" />
          <TextBlock Classes="h1" Text="{Binding CurrentText}" TextWrapping="Wrap" />
          <hwc:MotorLayoutView Layout="{Binding CurrentLayout}" ShowLabels="True" Width="260" Height="260"
                               IsVisible="{Binding HasCurrentLayout}" />
          <StackPanel Spacing="4" IsVisible="{Binding HasCurrentLayout}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" />
              <TextBlock Text="{l:Tr 'Clockwise'}" Classes="muted" />
              <Ellipse Width="12" Height="12" Fill="{DynamicResource Info}" Margin="12,0,0,0" />
              <TextBlock Text="{l:Tr 'Counter-clockwise'}" Classes="muted" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{l:Tr 'Numbers are motor outputs; letters are the Motor Test order. Front is up.'}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
