<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:hw="using:MissionPlanner.App.Core.ViewModels.SetupScreens.Hardware"
             xmlns:hwv="using:MissionPlanner.App.Views.SetupScreens.Hardware"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.SetupScreens.ParachuteView"
             x:DataType="vm:ParachuteViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">
      <hwv:PageHeader Description="Parachute release: enable it, choose how it is triggered (a relay or a servo output) and the minimum altitude for a release. Changes are written as you make them." />

      <WrapPanel>
        <Border Classes="card" Width="560" Margin="0,0,16,16" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{l:Tr 'Parachute'}" Margin="0,0,0,4" />
            <hwv:ParamRow DataContext="{Binding Enabled}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding !IsEnabled}"
                       Text="{l:Tr 'Enable the parachute to set it up (its other settings are downloaded when it is enabled).'}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsEnabled}">
              <hwv:ParamRow DataContext="{Binding Type}" />
              <StackPanel Spacing="6" IsVisible="{Binding IsServo}">
                <hwv:ChannelPickerRow DataContext="{Binding Output}" />
                <hwv:ParamRow DataContext="{Binding ServoOff}" />
                <hwv:ParamRow DataContext="{Binding ServoOn}" />
              </StackPanel>
              <hwv:ParamRow DataContext="{Binding AltMin}" />
              <ItemsControl ItemsSource="{Binding Other}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="hw:ParamField">
                    <hwv:ParamRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Width="300" Margin="0,0,16,16" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{l:Tr 'Notes'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                       Text="{l:Tr 'A servo release needs a servo output whose function is Parachute; picking one here sets it and clears any other output that had it.'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                       Text="{l:Tr 'The parachute is only released above the minimum altitude (0 = no limit). Test the release with the propellers removed.'}" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
