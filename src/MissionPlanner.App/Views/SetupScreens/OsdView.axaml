<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:hw="using:MissionPlanner.App.Core.ViewModels.SetupScreens.Hardware"
             xmlns:oh="using:MissionPlanner.App.Core.ViewModels.SetupScreens.OptionalHardware"
             xmlns:hwv="using:MissionPlanner.App.Views.SetupScreens.Hardware"
             xmlns:ohc="using:MissionPlanner.App.Controls.SetupScreens.OptionalHardware"
             x:Class="MissionPlanner.App.Views.SetupScreens.OsdView"
             x:DataType="vm:OsdViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.items ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16">
      <hwv:PageHeader Description="On-screen display: the OSD type and options, each screen's settings, and the layout of every screen. Settings are written as you change them; drag elements on the screen to place them, then Write layout." />

      <WrapPanel>
        <Border Classes="card" Width="560" Margin="0,0,16,0" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="OSD" Margin="0,0,0,4" />
            <hwv:ParamRow DataContext="{Binding OsdType}" />
            <Expander Header="{Binding General.Count, StringFormat='General settings ({0})'}" HorizontalAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding General}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="hw:ParamField">
                    <hwv:ParamRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>
        <Border Classes="card" Width="420" VerticalAlignment="Top" IsVisible="{Binding HasTelemetryRates}">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="MAVLink OSD (MinimOSD)" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="You only need this if an external MAVLink OSD is not updating: sets the telemetry stream rates on serial 0, 1 and 3 to 2 Hz." />
            <Button Content="Enable Telemetry" Command="{Binding EnableTelemetryCommand}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- layout editor -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OsdScreenViewModel">
                  <TextBlock Text="{Binding Title}" Margin="4,0" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <CheckBox Content="Auto write on leaving" IsChecked="{Binding AutoWriteOnLeave}" />
              <Button Classes="tool" Content="Refresh" Command="{Binding RefreshParamsCommand}" />
              <Button Classes="tool" Content="Discard" Command="{Binding DiscardCommand}" IsEnabled="{Binding HasChanges}" />
              <Button Classes="tool accent" Content="{Binding WriteText}" Command="{Binding WriteCommand}" />
            </StackPanel>
          </Grid>

          <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6">
            <ComboBox ItemsSource="{Binding Grids}" SelectedItem="{Binding SelectedGrid}" MinWidth="220"
                      ToolTip.Tip="Character grid of the display (the screen's text resolution for MSP DisplayPort HD)" />
            <CheckBox Content="Show names" IsChecked="{Binding ShowNames}" />
            <Button Classes="tool" Content="Clear all" Command="{Binding ClearAllCommand}"
                    ToolTip.Tip="Switch every element of this screen off" />
            <Button Classes="tool" Content="Copy layout" Command="{Binding CopyLayoutCommand}" />
            <Button Classes="tool" Content="Paste layout" Command="{Binding PasteLayoutCommand}" IsEnabled="{Binding CanPaste}"
                    ToolTip.Tip="Copy positions and visibility from the copied screen" />
          </WrapPanel>

          <Grid Grid.Row="2" ColumnDefinitions="*,16,300">
            <ohc:OsdCanvas Name="Canvas" MinHeight="380" MaxHeight="560" VerticalAlignment="Top"
                           Items="{Binding SelectedScreen.Items, FallbackValue={x:Null}}"
                           Version="{Binding SelectedScreen.LayoutVersion, FallbackValue=0}"
                           Grid="{Binding SelectedGrid.Grid, FallbackValue={x:Static oh:OsdGrid.Sd}}"
                           SelectedItem="{Binding SelectedItem}"
                           ShowNames="{Binding ShowNames}"
                           ScreenBrush="{DynamicResource Bg0}" GridLineBrush="{DynamicResource Bg2}"
                           TextBrush="{DynamicResource Text}" MutedBrush="{DynamicResource Muted}"
                           SelectionBrush="{DynamicResource Accent}" ChangedBrush="{DynamicResource Info}" />

            <StackPanel Grid.Column="2" Spacing="10">
              <!-- the selected element -->
              <Border Background="{DynamicResource Bg2}" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Classes="muted" FontSize="11" FontWeight="Bold" Text="SELECTED ELEMENT" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"
                             Text="Click an element on the screen or in the list. Drag it, or move it with the arrow keys." />
                  <StackPanel Spacing="6" IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SelectedItem.Name, FallbackValue=''}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedItem.Prefix, FallbackValue=''}" />
                    <CheckBox Content="Shown" IsChecked="{Binding SelectedItem.Enabled, FallbackValue=False}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                      <TextBlock Text="X" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Value="{Binding SelectedItem.XValue, FallbackValue={x:Null}}" Minimum="0" Maximum="59"
                                     Increment="1" FormatString="0" />
                      <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="6,0,0,0" />
                      <NumericUpDown Grid.Column="3" Value="{Binding SelectedItem.YValue, FallbackValue={x:Null}}" Minimum="0" Maximum="21"
                                     Increment="1" FormatString="0" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- every element of the screen -->
              <Border Background="{DynamicResource Bg2}" CornerRadius="6" Padding="6">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Classes="muted" FontSize="11" FontWeight="Bold" Margin="4,2,0,6"
                             Text="{Binding SelectedScreen.EnabledCount, StringFormat='ELEMENTS ({0} SHOWN)', FallbackValue='ELEMENTS'}" />
                  <ListBox Grid.Row="1" Classes="items" ItemsSource="{Binding SelectedScreen.Items, FallbackValue={x:Null}}"
                           SelectedItem="{Binding SelectedItem}" MaxHeight="420" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="oh:OsdItem">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Padding="0" Margin="0,0,6,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="muted" FontSize="11" VerticalAlignment="Center">
                            <Run Text="{Binding X}" /><Run Text="," /><Run Text="{Binding Y}" />
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- the screen's own settings -->
      <Border Classes="card" Width="560" HorizontalAlignment="Left" IsVisible="{Binding SelectedScreen, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="{Binding SelectedScreen.Title, StringFormat='{}{0} settings', FallbackValue='Screen settings'}" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding SelectedScreen.Settings, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="hw:ParamField">
                <hwv:ParamRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
