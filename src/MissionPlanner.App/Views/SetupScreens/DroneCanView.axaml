<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.SetupScreens"
             xmlns:comms="using:MissionPlanner.App.Core.ViewModels.SetupScreens.Comms"
             x:Class="MissionPlanner.App.Views.SetupScreens.DroneCanView"
             x:DataType="vm:DroneCanViewModel">

  <UserControl.Resources>
    <FontFamily x:Key="CanMono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.health">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.health.warning">
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="TextBlock.health.bad">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="TextBox.param.changed">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBox.param.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="DroneCAN / UAVCAN" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Nodes on a CAN bus — reached through the autopilot (MAVLink CAN forwarding) or an SLCAN adapter — with their health, versions and parameters. Select a node to read or change its parameters, restart it or update its firmware." />
      </StackPanel>
      <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" VerticalAlignment="Center" Margin="16,0,0,0"
                   IsVisible="{Binding IsBusy}" />
    </Grid>

    <Border Grid.Row="1" Margin="0,12,0,0" Background="#33f0b429" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
            CornerRadius="6" Padding="12,8" IsVisible="{Binding LibraryMissing}">
      <TextBlock TextWrapping="Wrap"
                 Text="This build does not include the DroneCAN library (ExtLibs/DroneCAN), so the bus cannot be opened. The page lists nodes once the app is built with it." />
    </Border>

    <!-- interface -->
    <Border Grid.Row="2" Classes="card" Margin="0,12,0,10" Padding="12,10">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsDisconnected}">
            <TextBlock Text="Bus" VerticalAlignment="Center" Classes="muted" />
            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" MinWidth="260" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSlcan}" IsEnabled="{Binding IsDisconnected}">
            <ComboBox ItemsSource="{Binding Ports}" IsEditable="True" Text="{Binding SelectedPort, Mode=TwoWay}" MinWidth="200" MaxWidth="340"
                    ToolTip.Tip="{Binding SelectedPort}" />
            <Button Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Look for serial ports again" Padding="6">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="18" Height="18" />
            </Button>
            <ComboBox ItemsSource="{Binding Bauds}" SelectedItem="{Binding SelectedBaud}" MinWidth="100" />
          </StackPanel>
          <Button Classes="accent" Content="{Binding ConnectText}" Command="{Binding ToggleConnectCommand}" MinWidth="110" />
        </WrapPanel>
        <TextBlock Grid.Column="1" Text="{Binding Traffic}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="3*,12,2*">
      <!-- nodes and their log messages -->
      <Grid RowDefinitions="*,12,Auto">
        <Border Classes="card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Classes="h2" Text="Nodes" Margin="14,10,14,8" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" AutoGenerateColumns="False"
                      HeadersVisibility="Column" RowHeight="32" IsReadOnly="True" SelectionMode="Single"
                      CanUserResizeColumns="True" CanUserSortColumns="True" BorderThickness="0" Background="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="ID" Width="58" Binding="{Binding Id}" />
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="Name" Width="2*" MinWidth="140" Binding="{Binding Name}" />
                <DataGridTemplateColumn x:DataType="comms:CanNodeRow" Header="Health" Width="90" SortMemberPath="Health">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="comms:CanNodeRow">
                      <TextBlock Classes="health" Classes.warning="{Binding IsWarning}" Classes.bad="{Binding IsBad}"
                                 Text="{Binding HealthText}" VerticalAlignment="Center" Margin="10,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="Mode" Width="150" Binding="{Binding ModeText}" />
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="Uptime" Width="90" Binding="{Binding UptimeText}" />
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="Software" Width="1.2*" Binding="{Binding SoftwareVersion}" />
                <DataGridTextColumn x:DataType="comms:CanNodeRow" Header="HW" Width="64" Binding="{Binding HardwareVersion}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Expander Grid.Row="2" Header="Node log messages" HorizontalAlignment="Stretch">
          <Grid RowDefinitions="Auto,Auto">
            <ListBox ItemsSource="{Binding LogMessages}" Height="150" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="comms:CanLogRow">
                  <TextBlock FontFamily="{StaticResource CanMono}" FontSize="12" TextWrapping="Wrap">
                    <Run Text="{Binding TimeText}" Foreground="{DynamicResource Muted}" />
                    <Run Text="{Binding NodeId, StringFormat='node {0}'}" />
                    <Run Text="{Binding Level}" Foreground="{DynamicResource Info}" />
                    <Run Text="{Binding Source}" Foreground="{DynamicResource Muted}" />
                    <Run Text="{Binding Text}" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,6,0,0" />
          </Grid>
        </Expander>
      </Grid>

      <!-- the selected node -->
      <Border Grid.Column="2" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <StackPanel Margin="14,10,14,6" Spacing="2">
            <TextBlock Classes="h2" Text="{Binding SelectedNodeTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" FontSize="12" FontFamily="{StaticResource CanMono}" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedNode.UniqueId, StringFormat='UID {0}', FallbackValue=''}"
                       IsVisible="{Binding HasSelectedNode}" />
          </StackPanel>

          <WrapPanel Grid.Row="1" Margin="14,0,14,8" ItemSpacing="8" LineSpacing="6">
            <Button Classes="accent" Content="Read parameters" Command="{Binding ReadParametersCommand}" />
            <Button Content="Restart" Command="{Binding RestartNodeCommand}" />
            <Button Content="Update firmware…" Command="{Binding UpdateFirmwareCommand}"
                    ToolTip.Tip="Send a .bin (or .apj) to the node: it fetches the file from Mission Planner over the bus" />
            <Button Content="Node info" Command="{Binding RequestInfoCommand}" ToolTip.Tip="Ask the node again for its name and versions" />
          </WrapPanel>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="14,0,14,8" IsVisible="{Binding IsUpdating}">
            <ProgressBar Value="{Binding FirmwareProgress}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"
                         ShowProgressText="False" />
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelUpdateCommand}" Margin="8,0,0,0" />
          </Grid>

          <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,8,14,4">
            <TextBlock Classes="h2" Text="{Binding ParametersTitle}" />
          </Border>

          <ScrollViewer Grid.Row="4">
            <StackPanel>
              <TextBlock Margin="14,10" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasParameters}"
                         Text="Select a node and press Read parameters." />
              <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="comms:CanParamRow">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,4">
                      <Grid ColumnDefinitions="*,130">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Classes="muted" FontSize="11">
                            <Run Text="{Binding KindText}" />
                            <Run Text="{Binding DefaultText, StringFormat='· default {0}'}" />
                            <Run Text="{Binding RangeText}" />
                          </TextBlock>
                        </StackPanel>
                        <TextBox Grid.Column="1" Classes="param" Classes.changed="{Binding IsChanged}" Classes.invalid="{Binding IsInvalid}"
                                 Text="{Binding ValueText}" IsReadOnly="{Binding IsReadOnly}" FontFamily="{StaticResource CanMono}"
                                 VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <WrapPanel Grid.Row="5" Margin="14,8,14,10" ItemSpacing="8" LineSpacing="6">
            <Button Classes="accent" Content="Write" Command="{Binding WriteParametersCommand}"
                    ToolTip.Tip="Send the changed values to the node" />
            <Button Content="Save to flash" Command="{Binding SaveParametersCommand}"
                    ToolTip.Tip="Make the node store its parameters (ExecuteOpcode SAVE)" />
            <Button Content="Reset to defaults" Command="{Binding EraseParametersCommand}"
                    ToolTip.Tip="Erase the stored parameters (ExecuteOpcode ERASE); defaults load after a restart" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="{Binding Status}" Foreground="{DynamicResource Info}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
