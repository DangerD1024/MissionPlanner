<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="using:MissionPlanner.App.Core.ViewModels.SetupScreens.Calibration"
             x:Class="MissionPlanner.App.Views.SetupScreens.CalibrationStatusBanner"
             x:DataType="cal:StatusLine"
             IsVisible="{Binding IsVisible}">

  <!-- an inline result line, tinted by kind -->
  <UserControl.Styles>
    <Style Selector="Border.banner">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource InfoSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Info}" />
    </Style>
    <Style Selector="Border.banner.success">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.banner.warning">
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="Border.banner.error">
      <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="banner"
          Classes.success="{Binding IsSuccess}"
          Classes.warning="{Binding IsWarning}"
          Classes.error="{Binding IsError}">
    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
  </Border>
</UserControl>
