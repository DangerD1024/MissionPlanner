<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Video"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Video.FpvCameraView"
             x:DataType="vm:FpvCameraViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="h2" Text="{l:Tr 'FPV camera of the 3D view'}" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="{l:Tr 'Changes show at once on the HUD. The pitch ladder follows the camera, so it stays on the 3D horizon.'}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="6">
      <CheckBox IsChecked="{Binding CustomFov}" Content="{l:Tr 'Own field of view (off: match the HUD pitch ladder)'}" />
      <Grid ColumnDefinitions="150,*,56" IsEnabled="{Binding CustomFov}">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Field of view (horizontal)'}" />
        <Slider Grid.Column="1" Minimum="30" Maximum="160" Value="{Binding Fov}" TickFrequency="5" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding FovText}" />
      </Grid>
      <Grid ColumnDefinitions="150,*,56" Margin="0,6,0,0">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Camera tilt (up)'}" />
        <Slider Grid.Column="1" Minimum="-30" Maximum="70" Value="{Binding Tilt}" TickFrequency="1" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TiltText}" />
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="{l:Tr 'FPV quads usually fly with the camera tilted up 20–40° and a 110–150° lens.'}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="{l:Tr 'Reset'}" Command="{Binding ResetCommand}" />
      <Button Content="{l:Tr 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="accent" Content="{l:Tr 'Close'}" Command="{Binding CloseCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</UserControl>
