<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Video"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Video.FpvCameraView"
             x:DataType="vm:FpvCameraViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="h2" Text="{l:Tr '3D view settings'}" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="{l:Tr 'Changes show at once on the HUD. The pitch ladder follows the camera, so it stays on the 3D horizon.'}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="6">
      <CheckBox IsChecked="{Binding CustomFov}" Content="{l:Tr 'Own field of view (off: match the HUD pitch ladder)'}" />
      <Grid ColumnDefinitions="180,*,56" IsEnabled="{Binding CustomFov}">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Field of view (horizontal)'}" />
        <Slider Grid.Column="1" Minimum="30" Maximum="160" Value="{Binding Fov}" TickFrequency="1" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding FovText}" />
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="180,0,56,0"
                 IsEnabled="{Binding CustomFov}" Text="{Binding DiagonalFovText}" />
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
        <RadioButton GroupName="tilt" IsChecked="{Binding ManualTilt}" Content="{l:Tr 'Fixed camera tilt'}" />
        <RadioButton GroupName="tilt" IsChecked="{Binding ServoTilt}" Content="{l:Tr 'Tilt driven by a servo'}" />
      </StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding ServoTilt}">
        <WrapPanel>
          <TextBlock Classes="muted" VerticalAlignment="Center" Width="180" Text="{l:Tr 'Servo output'}" />
          <ComboBox Width="110" ItemsSource="{Binding ServoNumbers}" SelectedItem="{Binding SelectedServo}" Margin="0,0,16,0">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='SERVO{0}'}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr 'From (1000 µs)'}" />
          <NumericUpDown Width="110" Minimum="-90" Maximum="90" Increment="1" FormatString="0" Value="{Binding ServoFrom}" Margin="0,0,16,0" />
          <TextBlock Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr 'To (2000 µs)'}" />
          <NumericUpDown Width="110" Minimum="-90" Maximum="90" Increment="1" FormatString="0" Value="{Binding ServoTo}" Margin="0,0,16,0" />
          <ToggleButton Content="{l:Tr 'Reverse'}" IsChecked="{Binding ServoReverse}"
                        ToolTip.Tip="{l:Tr 'Swap the ends: 1000 µs gives the To angle and 2000 µs the From angle'}" />
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="{l:Tr 'Angles are degrees below the nose line: negative looks up, 0 straight ahead, 90 straight down. In between, the angle follows the servo output linearly.'}" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ServoNowText}" />
      </StackPanel>
      <Grid ColumnDefinitions="180,*,56" IsVisible="{Binding ManualTilt}">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Camera tilt (up)'}" />
        <Slider Grid.Column="1" Minimum="-30" Maximum="70" Value="{Binding Tilt}" TickFrequency="1" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TiltText}" />
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="{l:Tr 'FPV quads usually fly with the camera tilted up 20–40° and a 110–150° lens.'}" />
      <Grid ColumnDefinitions="180,*,56" Margin="0,16,0,0">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Drawing distance'}" />
        <Slider Grid.Column="1" Minimum="2" Maximum="32" Value="{Binding DrawDistanceKm}" TickFrequency="1" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding DrawDistanceText}" />
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="{l:Tr 'Drawing distance applies to the HUD, 3D map and stream.'}" />
      <Grid ColumnDefinitions="180,*,56" Margin="0,16,0,0">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:Tr 'Hi-res preload'}" />
        <Slider Grid.Column="1" Minimum="0.5" Maximum="8" Value="{Binding HighresKm}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding HighresText}" />
      </Grid>
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="{l:Tr 'Radius around the aircraft preloaded with hi-res map tiles.'}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="{l:Tr 'Reset'}" Command="{Binding ResetCommand}" />
      <Button Content="{l:Tr 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="accent" Content="{l:Tr 'Close'}" Command="{Binding CloseCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</UserControl>
