<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.App.Core.ViewModels.Video"
             xmlns:l="using:MissionPlanner.App.Localization"
             x:Class="MissionPlanner.App.Views.Video.StreamSettingsView"
             x:DataType="vm:StreamSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="h2" Text="{l:Tr 'Stream the HUD to other apps'}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Accent}" IsVisible="{Binding IsAvailable}" />
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Danger}" IsVisible="{Binding !IsAvailable}" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Availability}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel>
        <TextBlock Classes="label" Text="{l:Tr 'Send as'}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />

        <Grid ColumnDefinitions="140,12,*" IsVisible="{Binding ShowsRtsp}">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'RTSP port'}" />
            <NumericUpDown Value="{Binding RtspPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="{l:Tr 'Path'}" />
            <TextBox Text="{Binding RtspPath}" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,12,140" IsVisible="{Binding ShowsUdp}">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'Send UDP to (address)'}" />
            <TextBox Text="{Binding UdpHost}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="{l:Tr 'UDP port'}" />
            <NumericUpDown Value="{Binding UdpPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,12,*,12,*">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'Resolution'}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="{l:Tr 'Frame rate'}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="{l:Tr 'Bitrate (kbit/s)'}" />
            <NumericUpDown Value="{Binding BitrateKbps}" Minimum="100" Maximum="50000" Increment="250" FormatString="0" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="label" Text="{l:Tr 'H.264 encoder'}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}" />

        <CheckBox Margin="0,14,0,0" IsChecked="{Binding ShowOsd}" Content="{l:Tr 'Show the HUD (OSD) over the picture in the stream'}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{l:Tr 'Other apps open rtsp://this-computer:port/path (VLC, QGroundControl, OBS, ffplay). UDP sends RTP/H.264 that QGroundControl or a UDP H.264 video source receives.'}" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock FontSize="12" Foreground="{DynamicResource Danger}" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{l:Tr 'Cancel'}" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Grid.Column="2" Classes="accent" Content="{l:Tr 'Save'}" Margin="8,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
    </Grid>
  </Grid>
</UserControl>
