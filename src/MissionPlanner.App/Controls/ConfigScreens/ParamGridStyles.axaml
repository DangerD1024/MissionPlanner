<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- shared by the Full Parameter List, Full Parameter Tree and User Params grids -->

  <Styles.Resources>
    <ResourceDictionary>
      <!-- a quiet selection, so the green of edited values stands out; light and dark themes -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#23303d" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#2a3846" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#23303d" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#2a3846" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#dce6f0" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#d0dcea" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#dce6f0" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#d0dcea" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock.name.modified">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="DataGrid.params DataGridCell">
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Button.side">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- the value cell's list of documented values -->
  <Style Selector="ListBox.choices ListBoxItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
</Styles>
