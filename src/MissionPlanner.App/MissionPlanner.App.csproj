<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MissionPlanner.App</RootNamespace>
    <AssemblyName>MissionPlanner.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Mission Planner's icon (repo root mpdesktop.ico): the executable on Windows; windows use it too -->
    <ApplicationIcon>Assets\mpdesktop.ico</ApplicationIcon>
    <!-- compiled bindings are the default in Avalonia 12; stated so it survives a downgrade -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mission Planner's own menu icons (Resources/light_*_icon.png), used by the Mission Planner theme -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- translation tables harvested from Mission Planner's .resx files (src/tools/LocalizationHarvest) -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="MissionPlanner.App.Localization.%(Filename).json" />
    <!-- the app's English strings, for the translation editor (TOOLS) -->
    <EmbeddedResource Include="Localization\untranslated.txt" LogicalName="MissionPlanner.App.Localization.untranslated.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionPlanner.App.Core\MissionPlanner.App.Core.csproj" />
  </ItemGroup>

  <!-- data files the shared libraries look for next to the executable, taken from the repo root -->
  <ItemGroup>
    <Content Include="..\..\ParameterMetaDataBackup.xml" Link="ParameterMetaDataBackup.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\mavcmd.xml" Link="mavcmd.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\APMotorLayout.json" Link="APMotorLayout.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\SerialOptionRules.json" Link="SerialOptionRules.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\acsimplepids.xml" Link="acsimplepids.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\checklistDefault.xml" Link="checklistDefault.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- OurAirports list for the maps' airports overlay (Map settings > Show airports), as Mission Planner ships it -->
    <Content Include="..\..\airports.csv" Link="airports.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- the icon for the Linux applications-menu entry (Help > Add to applications menu) -->
    <Content Include="Assets\mission-planner-128.png" Link="mission-planner-128.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dfu-util for flashing boards in STM32 DFU mode: this runtime's build to Tools/dfu-util (Tools/dfu-util/README.txt) -->
  <ItemGroup>
    <None Remove="Tools\**" />
  </ItemGroup>
  <Import Project="Tools\dfu-util\dfu-util.targets" />

  <!-- the neural speech engine (sherpa-onnx, onnxruntime) for this runtime, next to the app (Tools/sherpa-onnx/README.txt) -->
  <Import Project="Tools\sherpa-onnx\sherpa-onnx.targets" />

</Project>
