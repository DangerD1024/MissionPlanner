<Project Sdk="Microsoft.NET.Sdk">

  <!-- Services and view-models for the new app. No UI framework types belong here. -->
  <PropertyGroup>
    <RootNamespace>MissionPlanner.App.Core</RootNamespace>
    <!-- the 3D view hands pixel buffers to OpenGL -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ExtLibs\Mavlink\MAVLink.csproj" />
    <ProjectReference Include="..\..\ExtLibs\Comms\MissionPlanner.Comms.csproj" />
    <ProjectReference Include="..\..\ExtLibs\ArduPilot\MissionPlanner.ArduPilot.csproj" />
    <ProjectReference Include="..\..\ExtLibs\Utilities\MissionPlanner.Utilities.csproj" />
    <ProjectReference Include="..\..\ExtLibs\GMap.NET.Core\GMap.NET.Core.csproj" />
    <ProjectReference Include="..\..\ExtLibs\Maps\MissionPlanner.Maps.csproj" />
    <ProjectReference Include="..\..\ExtLibs\DroneCAN\DroneCAN.csproj" />
  </ItemGroup>

  <!-- the DroneCAN page's library adapter -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DRONECAN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlanner.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the libraries reference 4.7.0; the current package has the maintained Linux/macOS implementation -->
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 3D view: OpenGL 3.3 in a hidden GLFW window, rendered off screen; tiles decoded in managed code -->
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <!-- heights above the ellipsoid for NMEA and Cursor on Target, as Mission Planner -->
    <PackageReference Include="GeoidHeightsDotNet" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mission Planner's Cursor on Target event builder: plain C#, shared with the WinForms app -->
    <Compile Include="..\..\Controls\CotOutput.cs" Link="Outputs\Shared\CotOutput.cs" />
    <!-- Mission Planner's camera list for the survey, the same file the WinForms app ships -->
    <EmbeddedResource Include="..\..\camerasBuiltin.xml" Link="ViewModels\FlightPlan\camerasBuiltin.xml" LogicalName="camerasBuiltin.xml" />
  </ItemGroup>

</Project>
