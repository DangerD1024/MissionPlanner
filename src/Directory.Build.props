<Project>
  <!-- Shared settings for the new cross-platform app (src/ only; ExtLibs and the WinForms app are unaffected). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the reused ExtLibs assemblies are not strong-name or nullable aware; keep their warnings out of ours -->
    <NoWarn>$(NoWarn);NU1701;NU1603</NoWarn>
  </PropertyGroup>

  <!-- The app's version, shown in the window title and on Help. Change this one line for each release. -->
  <PropertyGroup>
    <MissionPlannerVersion>3.0.6b</MissionPlannerVersion>
  </PropertyGroup>

  <PropertyGroup>
    <InformationalVersion>$(MissionPlannerVersion)</InformationalVersion>
    <!-- assembly versions must be numeric: 3.0.2b -> 3.0.2 -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(MissionPlannerVersion), '^\d+(\.\d+){0,3}').Value)</Version>
    <!-- keep the git commit hash out of the displayed version -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
