<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- dark, no action bar; the app draws its own top bar under the system status bar -->
  <style name="MissionPlanner.Theme" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@color/mp_background</item>
    <item name="android:statusBarColor">@color/mp_background</item>
    <item name="android:navigationBarColor">@color/mp_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLayoutInDisplayCutoutMode">default</item>
    <item name="android:windowShowWallpaper">false</item>
  </style>
  <color name="mp_background">#0B0E13</color>
</resources>
