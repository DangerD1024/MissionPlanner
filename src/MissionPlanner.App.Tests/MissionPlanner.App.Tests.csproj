<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.3" />
    <!-- the SkiaSharp the app runs with (through Avalonia), with its native libraries for Linux and macOS -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>

  <!-- mode names come from the parameter docs; ship the offline copy so no test depends on a download -->
  <ItemGroup>
    <Content Include="..\..\ParameterMetaDataBackup.xml" Link="ParameterMetaDataBackup.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\APMotorLayout.json" Link="APMotorLayout.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionPlanner.App.Core\MissionPlanner.App.Core.csproj" />
  </ItemGroup>

  <!-- the bundled dfu-util, as the app ships it, so a test can check it lands in an output folder and runs -->
  <Import Project="..\MissionPlanner.App\Tools\dfu-util\dfu-util.targets" />

  <!-- the native neural speech engine, as the app ships it (the engine's tests load it; voices come from a local test archive) -->
  <Import Project="..\MissionPlanner.App\Tools\sherpa-onnx\sherpa-onnx.targets" />

</Project>
