<!--
  Windows installer (MSI) for Mission Planner 3 (src/MissionPlanner.App), WiX Toolset v5.
  Build it with build-msi.ps1 next to this file; it publishes the app and passes:
    -d Version=3.0.2   numeric MSI version (from MissionPlannerVersion in src/Directory.Build.props)
    -d DisplayVersion=3.0.2b
    -bindpath publish=<self-contained win-x64 publish folder>
  Installs per machine to "Program Files\Mission Planner 3", beside (not over) the classic
  Mission Planner, which has its own UpgradeCode and folder.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Mission Planner $(DisplayVersion)"
           Manufacturer="Mission Planner"
           Version="$(Version)"
           UpgradeCode="AADF0770-67AC-4BD8-8E6A-7234E10D9494"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Mission Planner $(DisplayVersion) installer" />

    <!-- a newer version replaces an older one; the same numeric version (3.0.2b then 3.0.2) too -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Mission Planner 3 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\..\src\MissionPlanner.App\Assets\mpdesktop.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DangerD1024/MissionPlanner" />
    <Property Id="ARPHELPLINK" Value="https://discuss.ardupilot.org/c/ground-control-software/mission-planner" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Mission Planner 3" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- the executable gets its own component so the shortcuts can point at it -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="MainExe" Source="!(bindpath.publish)\MissionPlanner.App.exe" KeyPath="yes">
          <!-- telemetry arrives as incoming UDP (any port the user picks) and TCP: allow it on every network
               profile, as the Windows prompt would only cover the network the PC was on at first start -->
          <fw:FirewallException Id="MainExeFirewall" Name="Mission Planner 3" Scope="any" Profile="all"
                                Description="MAVLink telemetry over UDP and TCP" />
        </File>
      </Component>
      <Files Include="!(bindpath.publish)\**">
        <Exclude Files="!(bindpath.publish)\MissionPlanner.App.exe" />
        <Exclude Files="!(bindpath.publish)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="Mission Planner 3"
                Description="Ground control station for ArduPilot vehicles"
                Target="[#MainExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\Mission Planner 3" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="INSTALLDESKTOPSHORTCUT = 1">
      <Shortcut Id="DesktopShortcut" Name="Mission Planner 3"
                Description="Ground control station for ArduPilot vehicles"
                Target="[#MainExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\Mission Planner 3" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <Feature Id="Main" Title="Mission Planner 3" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- licence, folder choice, install; "Launch" checkbox on the last page -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="..\..\Msi\licence.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Mission Planner 3" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="[#MainExe]" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
